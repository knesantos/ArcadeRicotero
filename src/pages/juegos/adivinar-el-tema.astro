---
/**
 * "Adiviná el tema" (`US-02`). Salió de la cocina: se juega.
 *
 * Es el juego que el usuario pidió calcado del molde de un juego que ya existe y anda
 * (el relevamiento está en `Docs/SUGERENCIAS/HILO-mapa-del-juego-de-referencia.md`), con la escalera que él fijó:
 * 0,1 · 0,5 · 2 · 4 · 8 · 15 segundos, y un intento por escalón.
 *
 * Viste **Lobo suelto** por la mezcla `D-19`, que le da ese disco a `mitologia`.
 *
 * Arquitectura de islas (`D-02`): el HTML sale estático y el único JavaScript es
 * `partida-tema.ts`. El catálogo se resuelve en build contra `RES-20`, así que al
 * navegador llega una lista ya cruzada, sin nada que el sitio no pueda sostener.
 *
 * **El estado sin audio no es un error, es una pantalla.** `D-23` dejó dicho que los
 * fragmentos salen de la máquina del usuario y no de este repo. Mientras no haya
 * ninguno, la portada lo dice con todas las letras y da el comando — en vez de ofrecer
 * un botón que no suena.
 *
 * **Molinetes abiertos (`D-14`):** no pide nada. Ni cuenta, ni login, ni saber.
 */
import '../../styles/tokens.css';
import '../../styles/juego.css';
import '../../styles/sitio.css';
import { catalogo, type Manifiesto } from '../../lib/tema/catalogo.ts';
import { PANTALLA_0, PARTIDA } from '../../lib/tema/copy.ts';
import { PORTAL } from '../../lib/sitio/copy.ts';
import { fondoTapa, discosDe } from '../../lib/sitio/arte.ts';
import manifiesto from '../../data/adivinar-tema.json';
import cancionero from '../../data/cancionero.json';

const conLetra = (cancionero as { temas: Array<{ slug: string; titulo: string }> }).temas.map(
  (t) => ({ slug: t.slug, titulo: t.titulo }),
);

const cat = catalogo(manifiesto as unknown as Manifiesto, conLetra);
const hayAudio = cat.jugables > 0;

const FONDO = 'lobo-tiras';
const fondo = fondoTapa(FONDO);
const tapasUsadas = fondo ? discosDe([FONDO]) : [];
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={PANTALLA_0.subtitulo} />
    <title>Adiviná el tema — Arcade Ricotero</title>
  </head>
  <body class="con-grano">
    <main id="app">
      {fondo && <div class="tapa-fondo tapa-fondo--lobo-tiras" aria-hidden="true" />}

      <section id="portada" class="pantalla sobre-tapa">
        <header class="cabecera-sitio">
          <a class="volver" href="/">← {PORTAL.volverAlArcade}</a>
        </header>
        <p class="marca" aria-label="Arcade Ricotero">ARCADE RICOTERO</p>
        <h1>{PANTALLA_0.titulo}</h1>
        <p class="tenue">{PANTALLA_0.subtitulo}</p>

        {
          hayAudio ? (
            <>
              <h2 class="elegi">{PANTALLA_0.elegiPozo}</h2>
              <ul class="pozos">
                <li>
                  <button class="pozo" type="button" data-disco="" aria-pressed="true">
                    <span class="pozo-titulo">{PANTALLA_0.todos}</span>
                    <span class="pozo-dato">{PANTALLA_0.hay(cat.jugables)}</span>
                  </button>
                </li>
                {cat.discos.map((d) => (
                  <li>
                    <button
                      class:list={['pozo', `pozo--${d.slug}`, { 'pozo--vacio': d.jugables === 0 }]}
                      type="button"
                      data-disco={d.slug}
                      aria-pressed="false"
                      disabled={d.jugables === 0}
                    >
                      <span class="pozo-titulo">{d.titulo}</span>
                      <span class="pozo-dato">
                        {d.jugables === 0 ? PANTALLA_0.sinAudio : PANTALLA_0.hay(d.jugables)}
                      </span>
                    </button>
                  </li>
                ))}
              </ul>
              {/* `US-02` criterio 2: el aviso va **antes de arrancar la partida**, no
                  durante. Nadie puede adivinar a ciegas sin saber que el audio no sonó. */}
              <p class="aviso-sonido">{PARTIDA.sinSonido}</p>
              <div class="arranque">
                <p id="cuantos" class="tenue">{PANTALLA_0.hay(cat.jugables)}</p>
                <button id="jugar" class="primario" type="button">{PANTALLA_0.boton}</button>
              </div>
            </>
          ) : (
            <div class="feedback no falta-audio">
              <p class="micro">{PANTALLA_0.sinAudio}</p>
              <p class="explicacion">{PANTALLA_0.faltaAudio}</p>
              <p class="comando">{PANTALLA_0.faltaAudioComo}</p>
            </div>
          )
        }
      </section>

      <section id="partida" class="pantalla sobre-tapa" hidden></section>
      <section id="resultado" class="pantalla sobre-tapa" hidden></section>

      <footer class="pie-sitio sobre-tapa">
        {tapasUsadas.length > 0 && <p class="credito-tapas">{PORTAL.creditoTapas(tapasUsadas)}</p>}
        {PORTAL.pie}
      </footer>
    </main>

    <script type="application/json" id="catalogo" set:html={JSON.stringify(cat.temas)} />
    {
      hayAudio && (
        <script>
          import '../../scripts/partida-tema.ts';
        </script>
      )
    }

    <style>
      main {
        max-width: 34rem;
        margin: 0 auto;
        position: relative;
        min-height: 100vh;
      }
      /* Esta pantalla viste Lobo suelto (D-19, seccion mitologia). */
      .marca {
        font-family: var(--fuente-titular);
        font-size: 2.1rem;
        line-height: 0.96;
        color: var(--marca-rojo);
        margin: var(--espacio-3) 0 var(--espacio-2);
        max-width: 7ch;
      }
      h1 {
        font-family: var(--fuente-rotulada);
        font-size: 1.5rem;
        line-height: 1.2;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--cat-mitologia);
        margin-top: 0;
      }
      .tenue {
        color: var(--texto-tenue);
      }
      .pantalla[hidden] {
        display: none;
      }
      .elegi {
        font-family: var(--fuente-rotulada);
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--texto-tenue);
        margin: var(--espacio-3) 0 var(--espacio-1);
      }
      /*
       * La accion vive en la zona del pulgar y no se va de la pantalla.
       *
       * Medido en 390x844, que es un celular comun: con once discos para elegir,
       * "Empeza" caia 36 px abajo del pliegue y habia que scrollear para arrancar un
       * juego que promete dos minutos. Pegado abajo, el que entra y toca "Empeza" sin
       * mirar la lista juega con todos los discos, que es el default correcto.
       */
      .arranque {
        position: sticky;
        bottom: 0;
        z-index: 3;
        padding-bottom: var(--espacio-1);
        background: var(--fondo);
      }
      #cuantos {
        margin: 0;
        padding-top: var(--espacio-1);
      }
      .primario {
        display: block;
        width: 100%;
        margin-top: var(--espacio-1);
        padding: var(--espacio-2);
        min-height: var(--toque-min);
        font-family: var(--fuente-rotulada);
        background: var(--cat-mitologia);
        color: var(--fondo);
        border: none;
        border-radius: var(--radio);
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: 0.04em;
      }
      .primario:disabled {
        background: var(--borde);
        color: var(--texto-tenue);
      }
      /* El comando se muestra tal cual se escribe: es para copiarlo, no para leerlo. */
      .comando {
        margin: var(--espacio-1) 0 0;
        padding: var(--espacio-1);
        background: var(--fondo);
        border: 1px solid var(--borde);
        border-radius: 3px;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.8rem;
        color: var(--texto);
        overflow-wrap: anywhere;
      }
      .falta-audio {
        margin-top: var(--espacio-3);
      }
      .credito-tapas {
        margin: 0 0 var(--espacio-1);
      }
    </style>
  </body>
</html>
