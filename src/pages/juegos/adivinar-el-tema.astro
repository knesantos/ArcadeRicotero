---
/**
 * "Adiviná el tema" (`US-02`). Salió de la cocina: se juega.
 *
 * Es el juego que el usuario pidió calcado del molde de un juego que ya existe y anda
 * (el relevamiento está en `Docs/SUGERENCIAS/HILO-mapa-del-juego-de-referencia.md`), con la escalera que él fijó:
 * 0,1 · 0,5 · 2 · 4 · 8 · 15 segundos, y un intento por escalón.
 *
 * Viste **Lobo suelto** por la mezcla `D-19`, que le da ese disco a `mitologia`.
 *
 * Arquitectura de islas (`D-02`): el HTML sale estático y el único JavaScript es
 * `partida-tema.ts`. El catálogo se resuelve en build contra `RES-20`, así que al
 * navegador llega una lista ya cruzada, sin nada que el sitio no pueda sostener.
 *
 * **El estado sin audio no es un error, es una pantalla.** `D-23` dejó dicho que los
 * fragmentos salen de la máquina del usuario y no de este repo. Mientras no haya
 * ninguno, la portada lo dice con todas las letras y da el comando — en vez de ofrecer
 * un botón que no suena.
 *
 * **Molinetes abiertos (`D-14`):** no pide nada. Ni cuenta, ni login, ni saber.
 */
import '../../styles/tokens.css';
import '../../styles/juego.css';
import '../../styles/sitio.css';
import { catalogo, type Manifiesto } from '../../lib/tema/catalogo.ts';
import { PANTALLA_0, PARTIDA } from '../../lib/tema/copy.ts';
import Cabeza from '../../components/Cabeza.astro';
import PieImprenta from '../../components/PieImprenta.astro';
import { PORTAL, LUGARES } from '../../lib/sitio/copy.ts';
import { fondoTapa, discosDe } from '../../lib/sitio/arte.ts';
import { claseDisco } from '../../lib/tema/paleta.ts';
import { ESCALERA } from '../../lib/tema/escalera.ts';
import manifiesto from '../../data/adivinar-tema.json';
import cancionero from '../../data/cancionero.json';
import setlistfm from '../../data/setlistfm.json';
import type { ConteoCitado } from '../../lib/en-vivo.ts';

const conLetra = (cancionero as { temas: Array<{ slug: string; titulo: string }> }).temas.map(
  (t) => ({ slug: t.slug, titulo: t.titulo }),
);

// `CTR-19.5`: la dificultad se deriva en build de lo mas tocado en vivo, segun el conteo
// que publica setlist.fm y el sitio cita (`D-45`). Los 8 temas del pozo que mas figuran
// son Faciles. Las vistas de YouTube ya no entran a este juego: son otra cuenta.
const conteo: ConteoCitado = (setlistfm as { conteo: ConteoCitado }).conteo;

const cat = catalogo(manifiesto as unknown as Manifiesto, conLetra, conteo);
const hayAudio = cat.jugables > 0;

const FONDO = 'lobo-tiras';
const fondo = fondoTapa(FONDO);
const tapasUsadas = fondo ? discosDe([FONDO]) : [];

const TITULO = 'Adiviná el tema — Arcade Ricotero';

/**
 * La bajada, cortada en el punto que el texto ya tiene: la primera oración es la que canta
 * (`voz-ricotera.md` §5), y el resto —"si no, te damos más: medio segundo, dos, cuatro…"—
 * lo dice ahora la tabla de premios, de un vistazo. Es el mismo corte que ya hace el portal
 * con las bajadas de los casetes. El texto entero no se toca: sigue siendo la descripción
 * de la página y lo sigue auditando `voz.test.ts`.
 */
const bajadaCorta = (() => {
  const corte = PANTALLA_0.subtitulo.indexOf('. ');
  return corte === -1 ? PANTALLA_0.subtitulo : PANTALLA_0.subtitulo.slice(0, corte + 1);
})();
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={PANTALLA_0.subtitulo} />
    <title>{TITULO}</title>
    <Cabeza titulo={TITULO} descripcion={PANTALLA_0.subtitulo} />
  </head>
  <body class="con-grano juego-tema">
    <main id="app">
      {fondo && <div class="tapa-fondo tapa-fondo--lobo-tiras" aria-hidden="true" />}

      <section id="portada" class="pantalla sobre-tapa">
        <header class="cabecera-sitio">
          <a class="volver" href="/">← {PORTAL.volverAlArcade}</a>
        </header>
        <p class="marca" aria-label="Arcade Ricotero">ARCADE RICOTERO</p>
        <h1>{PANTALLA_0.titulo}</h1>
        <p class="donde-estas">{LUGARES.tema}</p>
        <p id="subtitulo" class="tenue">{bajadaCorta}</p>

        {/*
            **La chapa de puntajes** (`US-02`): lo que vale cada escalón, impreso en papel y
            pegado con cinta, como la tabla de puntos que trae el mueble de un fichín.

            Reemplaza la mitad de la bajada que contaba la escalera en prosa. Es una tabla
            de verdad —`th` de fila y de columna— porque es un dato de dos entradas, y así la
            lee un lector de pantalla: "0,1 s, vale 100". Los números salen de `escalera.ts`,
            que es la única fuente de la escalera: si mañana cambia, cambia acá sola.
        */}
        <table class="premios">
          <caption class="solo-lector">{PANTALLA_0.premios.titulo}</caption>
          <tbody>
            <tr>
              <th scope="row">{PANTALLA_0.premios.audio}</th>
              {ESCALERA.map((p) => <td>{p.etiqueta}</td>)}
            </tr>
            <tr>
              <th scope="row">{PANTALLA_0.premios.vale}</th>
              {ESCALERA.map((p) => <td>{p.puntos}</td>)}
            </tr>
          </tbody>
        </table>

        {
          hayAudio ? (
            <>
              {/*
                  **Los once pozos entran en 119 px, no en 693** (`UX-24` §2).

                  Medido a 375×812 antes de tocarlo: once botones de 63 px en una columna
                  eran más de la mitad de la pantalla, y el juego entero no entraba en la
                  ventana. Ahora "Todos los discos" queda fijo y preseleccionado —que es el
                  default correcto, el mismo que ya defendía el `sticky` de `.arranque`— y
                  los otros diez se pliegan en dos columnas.

                  **Esto no es un molinete.** No se le niega nada a nadie: los diez están a
                  un toque, sin cuenta y sin saber nada. Lo que se saca es la obligación de
                  hacer dos pantallas de scroll para llegar al botón de empezar.
              */}
              <h2 class="elegi">{PANTALLA_0.elegiPozo}</h2>
              <ul class="pozos pozos--todos">
                <li>
                  <button class="pozo" type="button" data-disco="" aria-pressed="true">
                    <span class="pozo-titulo">{PANTALLA_0.todos}</span>
                    <span class="pozo-dato">{PANTALLA_0.hay(cat.jugables)}</span>
                  </button>
                </li>
              </ul>
              <details class="pozos-plegado">
                <summary class="pozos-abrir">{PANTALLA_0.elegiDisco}</summary>
                <ul class="pozos pozos--discos">
                  {cat.discos.map((d) => (
                    <li>
                      <button
                        class:list={['pozo', claseDisco(d.slug)]}
                        type="button"
                        data-disco={d.slug}
                        aria-pressed="false"
                        disabled={d.jugables === 0}
                      >
                        <span class="pozo-titulo">{d.titulo}</span>
                        <span class="pozo-dato">
                          {d.jugables === 0 ? PANTALLA_0.sinAudio : PANTALLA_0.hay(d.jugables)}
                        </span>
                      </button>
                    </li>
                  ))}
                </ul>
              </details>
              {/* `US-02` criterio 2: el aviso va **antes de arrancar la partida**, no
                  durante. Nadie puede adivinar a ciegas sin saber que el audio no sonó. */}
              <p class="aviso-sonido">{PARTIDA.sinSonido}</p>
              <div class="arranque">
                <p id="cuantos" class="tenue">{PANTALLA_0.hay(cat.jugables)}</p>
                <button id="jugar" class="primario" type="button">{PANTALLA_0.boton}</button>
              </div>
            </>
          ) : (
            <div class="feedback no falta-audio">
              <p class="micro">{PANTALLA_0.sinAudio}</p>
              <p class="explicacion">{PANTALLA_0.faltaAudio}</p>
              <p class="comando">{PANTALLA_0.faltaAudioComo}</p>
            </div>
          )
        }
      </section>

      <section id="partida" class="pantalla sobre-tapa" hidden></section>
      <section id="resultado" class="pantalla sobre-tapa" hidden></section>

    </main>

    <PieImprenta disco="lobo-suelto" tapas={tapasUsadas} />

    <script type="application/json" id="catalogo" set:html={JSON.stringify(cat.temas)} />
    {
      hayAudio && (
        <script>
          import '../../scripts/partida-tema.ts';
        </script>
      )
    }

    <style>
      /*
       * El cascaron ya no vive aca: es `body > main` en `juego.css` desde el 2026-09-02.
       *
       * Lo que estaba escrito en este lugar —el alto de la ventana MENOS lo que el `body`
       * gasta en su propio margen, y `svh` en vez de `vh` para descontar la barra del
       * navegador movil— era correcto y era **el unico de los seis juegos que lo tenia
       * bien junto con "sacalo por la letra"**. `adivinar-la-tapa` y `dos-ejes` seguian en
       * `100vh` con los 32 px de desplazamiento muerto, y `quiz` y `completar-la-letra` no
       * tenian nada. Por eso se mudo: el argumento estaba bien, el lugar estaba mal.
       */
      /* La portada ensancha porque es un tablero de once discos para elegir; el resto de
         las pantallas lo sigue topeando `.pantalla` en 34rem desde `juego.css`. Mismo
         corte y mismo argumento que `UX-10` uso para el portal. */
      @media (min-width: 46rem) {
        main {
          max-width: 46rem;
        }
      }
      /* Esta pantalla viste Lobo suelto (D-19, seccion mitologia). */
      /*
       * La firma del sitio es un sello, no el titular.
       *
       * Estaba en 2,1rem contra un h1 de 1,5rem: en la pantalla de un juego, el nombre
       * del sitio le ganaba en tamano al nombre del juego. Un diario no imprime la
       * cabecera mas grande que el titulo de la nota. La firma baja a sello —sigue
       * siendo el calco de la tapa, sigue siendo el rojo de Oktubre— y el titular se
       * queda con la voz alta.
       */
      /* La marca es componente global desde el ciclo 11 (`juego.css`). Esta pantalla la
         achica a proposito: es la mas densa del sitio y pelea el espacio por pixel. Lo
         unico que se sobrescribe es el tamano y el aire — y ahora tambien respira, en vez
         de quedar clavado en un rem fijo. A 375 px da lo mismo que antes. */
      /*
       * Los márgenes de esta pantalla, apretados contra el presupuesto de `UX-24` §1.
       *
       * **No se achicó ni una letra**: el `h1`, la bajada y el aviso de sonido miden lo
       * mismo que antes. Lo que cede es el aire entre bloques, que es lo que sobraba en la
       * pantalla más densa del sitio. Va acotado acá y no en `juego.css` porque los otros
       * cinco tableros no tienen once pozos y no necesitan apretarse.
       */
      .cabecera-sitio {
        margin-bottom: var(--espacio-1);
      }
      .donde-estas {
        margin-bottom: var(--espacio-1);
      }
      .marca {
        font-family: var(--fuente-titular);
        font-size: clamp(1.3rem, 6vw, 1.8rem);
        line-height: 0.96;
        letter-spacing: 0.02em;
        color: var(--marca-rojo);
        margin: var(--espacio-1) 0 var(--espacio-1);
        max-width: 7ch;
      }
      h1 {
        font-family: var(--fuente-rotulada);
        font-size: 2.3rem;
        line-height: 1.02;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        text-wrap: balance;
        color: var(--cat-mitologia);
        margin: 0 0 var(--espacio-1);
      }
      .tenue {
        color: var(--texto-tenue);
      }
      .pantalla[hidden] {
        display: none;
      }
      .elegi {
        font-family: var(--fuente-rotulada);
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--texto-tenue);
        margin: var(--espacio-3) 0 var(--espacio-1);
      }
      /*
       * La accion vive en la zona del pulgar y no se va de la pantalla.
       *
       * Medido en 390x844, que es un celular comun: con once discos para elegir,
       * "Empeza" caia 36 px abajo del pliegue y habia que scrollear para arrancar un
       * juego que promete dos minutos. Pegado abajo, el que entra y toca "Empeza" sin
       * mirar la lista juega con todos los discos, que es el default correcto.
       */
      .arranque {
        position: sticky;
        bottom: 0;
        z-index: 3;
        padding-bottom: var(--espacio-1);
        background: var(--fondo);
      }
      #cuantos {
        margin: 0;
        padding-top: var(--espacio-1);
        font-family: var(--fuente-rotulada);
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }
      /* La tecla de arrancar, con el mismo canto que las de la partida: una sombra dura
         abajo, en el apoyo de Lobo suelto, que se hunde al apretar. */
      .primario {
        display: block;
        width: 100%;
        margin: var(--espacio-1) 0 5px;
        padding: var(--espacio-2);
        min-height: var(--toque-min);
        font-family: var(--fuente-rotulada);
        background: var(--cat-mitologia);
        color: var(--fondo);
        border: none;
        border-radius: var(--radio);
        font-size: 1.35rem;
        font-weight: 400;
        letter-spacing: 0.05em;
        box-shadow: 0 5px 0 var(--cat-mitologia-apoyo);
        transition:
          translate var(--duracion-toque) var(--curva-cinta),
          box-shadow var(--duracion-toque) var(--curva-cinta);
        touch-action: manipulation;
      }
      .primario:active:not(:disabled) {
        translate: 0 4px;
        box-shadow: 0 1px 0 var(--cat-mitologia-apoyo);
      }
      .primario:disabled {
        background: var(--borde);
        color: var(--texto-tenue);
        box-shadow: none;
      }
      /* El aviso de sonido es registro 3: dice qué mirar y se calla. Va recortado con un
         borde punteado, como una nota agregada a mano, y no pelea con la chapa de arriba. */
      .aviso-sonido {
        padding: var(--espacio-1) var(--espacio-2);
        border: 2px dashed var(--borde);
        border-radius: 3px;
      }
      /* El comando se muestra tal cual se escribe: es para copiarlo, no para leerlo. */
      .comando {
        margin: var(--espacio-1) 0 0;
        padding: var(--espacio-1);
        background: var(--fondo);
        border: 1px solid var(--borde);
        border-radius: 3px;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.8rem;
        color: var(--texto);
        overflow-wrap: anywhere;
      }
      .falta-audio {
        margin-top: var(--espacio-3);
      }
    </style>
  </body>
</html>
