---
/**
 * "¿Qué tipo de ricotero sos?" (`US-06`, `D-57`). El único juego del sitio que no puntúa
 * con un número: devuelve una de cuatro maneras de pasar una noche de recital.
 *
 * Es el juego con el molinete más abierto (`UX-06` §0): no pide saber nada de la banda ni
 * haber ido nunca. Ninguna pregunta tiene respuesta correcta y ningún resultado es mejor que
 * otro — eso es `BR-17`, y es la regla más estricta que este juego tiene.
 *
 * Viste **Luzbelito** por la mezcla `D-19`, y desde el ciclo 18 lo viste entero: la portada
 * es la tapa del libro que fue ese disco (`RES-168`), la pregunta es una hoja y el resultado
 * la última (`UX-36`).
 *
 * Arquitectura de islas (`D-02`): HTML estático, y el único JavaScript es
 * `partida-dos-ejes.ts`. El banco se resuelve en build — al navegador llega el JSON con los
 * ítems `listo` y sin notas internas. Sus cuatro postales (`dos-ejes/[cu].astro`) son esta
 * misma página con el desafío puesto.
 */
import '../../styles/tokens.css';
import '../../styles/juego.css';
import '../../styles/sitio.css';
import { PANTALLA_0, TARJETA } from '../../lib/dos-ejes/copy.ts';
import { servir } from '../../lib/dos-ejes/servir.ts';
import { VISTA_PREVIA_JUEGO } from '../../lib/dos-ejes/arte.ts';
import Cabeza from '../../components/Cabeza.astro';
import PieImprenta from '../../components/PieImprenta.astro';
import Caratula from '../../components/Caratula.astro';
import Tapa from '../../components/dos-ejes/Tapa.astro';
import { caratulaDe, tapasConCaratula } from '../../lib/sitio/caratula.ts';
import { LUGARES, PORTAL } from '../../lib/sitio/copy.ts';
import crudo from '../../data/dos-ejes.json';

const banco = servir(crudo as unknown as Parameters<typeof servir>[0]);

// El casete del portal, en la mano (`D-54`): la carátula y la tinta de la página.
const caratula = caratulaDe('/juegos/dos-ejes/');

const TITULO = '¿Qué tipo de ricotero sos? — Fichín Ricotero';
const SUBTITULO = PANTALLA_0.subtitulo(banco.momentos.length, banco.preguntasPorEje * 2);
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={SUBTITULO} />
    <title>{TITULO}</title>
    <Cabeza titulo={TITULO} descripcion={SUBTITULO} imagen={VISTA_PREVIA_JUEGO} imagenAlt={TARJETA.altJuego} />
  </head>
  <body class="con-grano">
    <main id="app" class={`juego--${caratula.casete.variante} disco--luzbelito`}>
      <section id="inicio" class="pantalla">
        <header class="cabecera-sitio">
          <a class="volver" href="/">← {PORTAL.volverAlArcade}</a>
        </header>
        <p class="marca" aria-label="Fichín Ricotero">FICHÍN RICOTERO</p>
        <h1>{PANTALLA_0.titulo}</h1>
        <p class="donde-estas">{LUGARES.dosEjes}</p>
        <Tapa momentos={banco.momentos} />
        <p id="subtitulo" class="tenue">{SUBTITULO}</p>
        <button id="empezar" class="primario ejes-empezar" type="button">{PANTALLA_0.boton}</button>
      </section>

      <section id="pregunta" class="pantalla" hidden></section>
      <section id="resultado" class="pantalla" hidden></section>

      <!-- La única región viva de la noche (`UX-36` §8.2): existe antes de que su texto cambie,
           y vive afuera de las secciones que la isla vacía y rellena. -->
      <p id="ejes-anuncio" class="solo-lector" role="status" aria-live="polite" aria-atomic="true"></p>

      <Caratula caratula={caratula} />
    </main>

    <PieImprenta disco="luzbelito" tapas={tapasConCaratula(['Luzbelito'], caratula)} />

    <script type="application/json" id="banco" set:html={JSON.stringify(banco)} />
    <script>
      import '../../scripts/partida-dos-ejes.ts';
    </script>

    <style>
      /* El cascaron —ancho, centrado, `position: relative` y el alto minimo de una
         ventana— vive en `juego.css` (`body > main`) desde el 2026-09-02. Todo lo que pinta
         la isla vive en `juego.css` (`.ejes-*`): el estilo de un `.astro` tiene alcance y no
         llega a lo que crea el JavaScript. */
      .tenue {
        color: var(--texto-tenue);
      }
      .pantalla[hidden] {
        display: none;
      }
    </style>
  </body>
</html>
