---
/**
 * Pantalla "en la cocina" de `US-03` (completar la letra).
 * Viste La mosca y la sopa (mezcla `D-19`, seccion letras).
 */
import Base from '../../layouts/Base.astro';
import { COCINA, COCINA_VOLVER, PORTAL } from '../../lib/sitio/copy.ts';
import { conRecorteReal } from '../../lib/sitio/arte.ts';

const c = COCINA['completar-la-letra']!;
---

<Base
  titulo={`${c.titulo} — Arcade Ricotero`}
  descripcion={c.queVaASer}
  volverA={{ href: '/', texto: PORTAL.volverAlArcade }}
>
  <section class={`cocina cocina--${c.variante}`}>
    <h1>{c.titulo}</h1>
    <img class="cocina-arte" src={conRecorteReal(c.arte)} alt="" aria-hidden="true" />
    <p class="cocina-explica">{c.queVaASer}</p>
    <p class="cocina-estado">{c.estado}</p>
  </section>
  <a class="accion-abajo" href="/">{COCINA_VOLVER}</a>
</Base>
