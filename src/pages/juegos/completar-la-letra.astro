---
/**
 * "Completá la letra" (`US-03`).
 *
 * La pantalla tiene **dos estados reales**, y cuál sale depende del banco:
 *
 *  · Con ítems `listo`, se juega, igual que el quiz y que adivinar la tapa.
 *  · Sin ítems `listo`, dice por qué no. Y el porqué no es "todavía no lo hicimos":
 *    los 313 versos candidatos ya están generados y esperan que alguien los confirme de
 *    oído contra el disco, porque `CTR-04` no deja jugar un verso que nadie escuchó.
 *
 * La página no elige entre los dos: los dos están escritos y el banco decide. El día que
 * se confirme el primer verso, esto se prende solo.
 *
 * Viste La mosca y la sopa (mezcla `D-19`, sección letras).
 * **Molinetes abiertos (`D-14`):** no pide nada.
 */
import '../../styles/tokens.css';
import '../../styles/juego.css';
import '../../styles/sitio.css';
import { cargarBanco, type BancoCrudo } from '../../lib/letra/banco.ts';
import { PANTALLA_0, SIN_BANCO } from '../../lib/letra/copy.ts';
import Cabeza from '../../components/Cabeza.astro';
import PieImprenta from '../../components/PieImprenta.astro';
import { PORTAL, LUGARES } from '../../lib/sitio/copy.ts';
import { fondoTapa, discosDe } from '../../lib/sitio/arte.ts';
import crudo from '../../data/letra.json';

const items = cargarBanco(crudo as unknown as BancoCrudo);
const hayJuego = items.length > 0;
const FONDO = 'mosca-olla';
const fondo = fondoTapa(FONDO);
// `D-21` condicion 1: la pantalla que muestra una tapa velada tiene que nombrar de que
// disco es. Esta pagina la mostraba y no lo nombraba.
const tapasUsadas = fondo ? discosDe([FONDO]) : [];

const TITULO = 'Completá la letra — Arcade Ricotero';
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={PANTALLA_0.subtitulo} />
    <title>{TITULO}</title>
    <Cabeza titulo={TITULO} descripcion={PANTALLA_0.subtitulo} />
  </head>
  <body class="con-grano">
    <main id="app">
      {fondo && <div class="tapa-fondo tapa-fondo--mosca-olla" aria-hidden="true" />}

      <section id="portada" class="pantalla sobre-tapa">
        <header class="cabecera-sitio">
          <a class="volver" href="/">← {PORTAL.volverAlArcade}</a>
        </header>
        <p class="marca" aria-label="Arcade Ricotero">ARCADE RICOTERO</p>

        {
          hayJuego ? (
            <>
              <h1>{PANTALLA_0.titulo}</h1>
              <p class="donde-estas">{LUGARES.letra}</p>
              <p class="tenue">{PANTALLA_0.subtitulo}</p>
              <button id="jugar" class="primario" type="button">
                {PANTALLA_0.boton}
              </button>
            </>
          ) : (
            <>
              <h1>{SIN_BANCO.titulo}</h1>
              <p class="tenue">{SIN_BANCO.explica}</p>
              <p class="tenue">{SIN_BANCO.mientras}</p>
              <a class="primario" href="/letras-y-acordes/">
                {SIN_BANCO.boton}
              </a>
            </>
          )
        }
      </section>

      <section id="partida" class="pantalla" hidden></section>
      <section id="resultado" class="pantalla" hidden></section>

    </main>

    <PieImprenta disco="la-mosca-y-la-sopa" tapas={tapasUsadas} />

    {/* El banco viaja ya filtrado: sin borradores, sin notas internas. */}
    <script id="banco" type="application/json" set:html={JSON.stringify(items)} />
    {hayJuego && <script src="../../scripts/partida-letra.ts"></script>}

    <script>
      // El interruptor de la cinta (`UX-21`). Isla propia: no sabe nada del juego
      // y el juego no sabe nada de ella. Va sin la guarda de `hayJuego`: la cinta no
      // depende de que haya banco cargado.
      import '../../scripts/cinta.ts';
    </script>
  </body>
</html>
