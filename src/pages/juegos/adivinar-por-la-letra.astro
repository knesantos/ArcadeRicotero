---
/**
 * "Sacalo por la letra" (`US-07`). El juego nuevo del ciclo 9.
 *
 * Se muestran versos y hay que sacar de qué tema son, con el mismo buscador sobre los
 * 105 títulos que usa "Adiviná el tema". La escalera son cuatro pasos que duplican
 * (`BR-20`): 1 / 2 / 4 / 8 versos acumulados, y errar —o pasar— abre el siguiente.
 *
 * **Convive con `US-02`, no lo reemplaza** (decisión del usuario, 2026-08-25). Uno se
 * juega de oído y el otro leyendo; comparten catálogo, buscador y escala de puntos.
 *
 * Viste **Momo Sampler** (`UX-08`): ninguna de las diez tapas estaba tomada como
 * identidad de sección salvo las cuatro de `D-19`, y vestirlo igual que su hermano
 * mecánico (Lobo suelto) o que su primo de contenido (La mosca y la sopa) haría que dos
 * juegos casi gemelos se leyeran como el mismo con dos nombres.
 *
 * **El banco sale de `cancionero.json` vía `CTR-09`**, filtrado por `CNT-11`: ningún
 * verso mostrado contiene el título, o el juego se ganaría solo.
 *
 * **Molinetes abiertos (`D-14`):** no pide nada. Ni cuenta, ni login, ni saber.
 */
import '../../styles/tokens.css';
import '../../styles/juego.css';
import '../../styles/sitio.css';
import Cabeza from '../../components/Cabeza.astro';
import { PANTALLA_0 } from '../../lib/por-la-letra/copy.ts';
import { PORTAL, LUGARES } from '../../lib/sitio/copy.ts';
import { leerTemas, slugDeTitulo } from '../../lib/letra/temas.ts';
import { FICHAS } from '../../lib/cancionero/banco.ts';
import bancoCrudo from '../../data/por-la-letra.json';

/** Lo que viaja del banco: sin `desde` ni `dificultadSegun`, que son de generación. */
const items = (bancoCrudo as { items: Array<Record<string, unknown>> }).items.map((i) => ({
  slug: i.slug,
  titulo: i.titulo,
  versos: i.versos,
  dificultad: i.dificultad,
  fuente: { sitio: (i.fuente as Record<string, string>).sitio, url: (i.fuente as Record<string, string>).url },
}));

/**
 * El catálogo del buscador: **los 105 de `RES-20`, no los 93 del banco.**
 *
 * Es a propósito y es el mismo criterio que `D-24` fijó para el hermano: la lista de
 * títulos entre los que se elige tiene que ser la discografía entera. Si solo trajera los
 * que están en el banco, el buscador filtraría la respuesta — el que sabe que faltan doce
 * temas los descartaría sin escuchar nada.
 */
const porDisco = new Map(FICHAS.map((f) => [f.slug, f]));
const catalogo = leerTemas().map((t) => ({
  slug: slugDeTitulo(t.titulo),
  titulo: t.titulo,
  disco: t.disco,
  discoTitulo: porDisco.get(t.disco)?.titulo ?? t.disco,
  pista: t.pista,
  // El año sale de la misma ficha de disco que ya se está leyendo dos líneas arriba: es
  // lo que le falta a la revelación para decir de dónde salió el tema, y no cuesta
  // ninguna consulta nueva.
  anio: porDisco.get(t.disco)?.anio ?? 0,
}));

const TITULO = 'Sacalo por la letra — Arcade Ricotero';
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={PANTALLA_0.subtitulo} />
    <title>{TITULO}</title>
    <Cabeza titulo={TITULO} descripcion={PANTALLA_0.subtitulo} />
  </head>
  <body class="con-grano juego-por-la-letra">
    <main id="app">
      <section id="portada" class="pantalla sobre-tapa">
        <header class="cabecera-sitio">
          <a class="volver" href="/">← {PORTAL.volverAlArcade}</a>
        </header>
        <p class="marca" aria-label="Arcade Ricotero">ARCADE RICOTERO</p>
        <h1>{PANTALLA_0.titulo}</h1>
        <p class="donde-estas">{LUGARES.porLaLetra}</p>
        {/* La isla reemplaza esta bajada cuando alguien llega por un desafío (`ADR-02`). */}
        <p id="subtitulo" class="tenue">{PANTALLA_0.subtitulo}</p>

        <div class="arranque">
          <p class="tenue">{PANTALLA_0.hay(items.length)}</p>
          <button id="jugar" class="primario" type="button">{PANTALLA_0.boton}</button>
        </div>
      </section>

      <section id="partida" class="pantalla sobre-tapa" hidden></section>
      <section id="resultado" class="pantalla sobre-tapa" hidden></section>

      <footer class="pie-sitio sobre-tapa">{PORTAL.pie}</footer>
    </main>

    <script type="application/json" id="banco" set:html={JSON.stringify(items)} />
    <script type="application/json" id="catalogo" set:html={JSON.stringify(catalogo)} />
    <script src="../../scripts/partida-por-la-letra.ts"></script>

    <script>
      // El interruptor de la cinta (`UX-21`). Isla propia: no sabe nada del juego
      // y el juego no sabe nada de ella.
      import '../../scripts/cinta.ts';
    </script>

    <style>
      /*
       * Esta página no tenía bloque de estilo. Ninguno.
       *
       * Y no era una economía: era un agujero. `.marca` no existe en ninguna hoja global
       * —`sitio.css` define `.marca-chica`, `.marca-grande` y `.marca-rotulo`, ninguna de
       * ellas— y no hay regla que alcance al `h1`. Medido antes de tocar nada: el título
       * del juego salía a 32 px, que es el `2em` por defecto **del navegador**, en la
       * letra del sistema y en el color del texto común. O sea que el único juego del
       * sitio cuyo título no vestía nada era éste, y encima el nombre del sitio arriba
       * salía igual de crudo.
       *
       * El molde es el del hermano ya pulido (`adivinar-el-tema.astro`), con la tinta que
       * le toca a este juego: Momo Sampler, que es lo que `UX-08` le asignó.
       */
      main {
        max-width: 34rem;
        margin: 0 auto;
        position: relative;
        /* El alto de la ventana MENOS lo que el `body` gasta en su propio margen. Con
           `100svh` pelado la portada arrancaba con 32 px de scroll que no llevaban a
           ninguna parte. Mismo arreglo que el hermano. */
        min-height: calc(100svh - var(--espacio-2) * 2);
      }

      /* La firma del sitio es un sello, no el titular: el nombre del juego manda. */
      /* Igual que su hermano de audio: la marca es global (`juego.css`) y esta pantalla
         la achica porque el tablero pelea el espacio por pixel. A 375 px no cambia nada. */
      .marca {
        font-family: var(--fuente-titular);
        font-size: clamp(1.3rem, 6vw, 1.8rem);
        line-height: 0.96;
        letter-spacing: 0.02em;
        color: var(--marca-rojo);
        margin: var(--espacio-2) 0;
        max-width: 7ch;
      }

      h1 {
        font-family: var(--fuente-rotulada);
        font-size: 2.3rem;
        line-height: 1.02;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        text-wrap: balance;
        /* La plata de la tapa de Momo Sampler (`RES-37`), 13,29:1 sobre el fondo. */
        color: var(--disco-momo-sampler-tinta);
        margin: 0 0 var(--espacio-1);
      }

      .tenue {
        color: var(--texto-tenue);
      }

      .pantalla[hidden] {
        display: none;
      }

      /*
       * La acción vive en la zona del pulgar y no se va de la pantalla. Es la misma cinta
       * pegada abajo que el hermano, y acá hace todavía más falta: entre el botón y el pie
       * había cuatrocientos píxeles de nada.
       */
      .arranque {
        margin-top: var(--espacio-4);
      }

      #jugar {
        margin-top: var(--espacio-1);
      }
    </style>
  </body>
</html>
