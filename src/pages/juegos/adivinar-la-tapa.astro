---
/**
 * "Adiviná la tapa" (`US-04`). Dejó de estar en la cocina: se juega.
 *
 * Es la única pantalla donde las tapas reales son el **contenido** del juego y no la
 * decoración de la sección (`D-21`, `UX-04`). Viste Último bondi por la mezcla `D-19`.
 *
 * Arquitectura de islas (`D-02`): HTML estático, y el único JavaScript es
 * `partida-tapa.ts`. El banco se resuelve en build — al navegador llega JSON ya
 * filtrado, sin notas internas y sin ítems en borrador.
 *
 * **Molinetes abiertos (`D-14`):** no pide nada. Ni cuenta, ni login, ni saber.
 */
import '../../styles/tokens.css';
import '../../styles/juego.css';
import '../../styles/sitio.css';
import { cargarBanco, type BancoCrudo } from '../../lib/tapa/banco.ts';
import { PANTALLA_0 } from '../../lib/tapa/copy.ts';
import Cabeza from '../../components/Cabeza.astro';
import PieImprenta from '../../components/PieImprenta.astro';
import Caratula from '../../components/Caratula.astro';
import { caratulaDe, tapasConCaratula } from '../../lib/sitio/caratula.ts';
import { PORTAL, LUGARES } from '../../lib/sitio/copy.ts';
import { fondoTapa, discosDe } from '../../lib/sitio/arte.ts';
import crudo from '../../data/tapa.json';

const items = cargarBanco(crudo as unknown as BancoCrudo);
const FONDO = 'bondi-engranajes';
const fondo = fondoTapa(FONDO);
// `D-21` condicion 1: la pantalla que muestra una tapa velada tiene que nombrar de que
// disco es. Esta pagina la mostraba y no lo nombraba.
const tapasUsadas = fondo ? discosDe([FONDO]) : [];

// El casete del portal, en la mano (`D-54`): la carátula y la tinta de la página.
const caratula = caratulaDe('/juegos/adivinar-la-tapa/');

const TITULO = 'Adiviná la tapa — Fichín Ricotero';
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={PANTALLA_0.subtitulo} />
    <title>{TITULO}</title>
    <Cabeza titulo={TITULO} descripcion={PANTALLA_0.subtitulo} />
  </head>
  <body class="con-grano">
    <main id="app" class={`juego--${caratula.casete.variante}`}>
      {fondo && <div class="tapa-fondo tapa-fondo--bondi-engranajes" aria-hidden="true" />}

      <section id="portada" class="pantalla sobre-tapa">
        <header class="cabecera-sitio">
          <a class="volver" href="/">← {PORTAL.volverAlArcade}</a>
        </header>
        <p class="marca"><img src="/marca/fichin-ricotero.svg" alt="Fichín Ricotero" width="1540" height="1450" /></p>
        <h1>{PANTALLA_0.titulo}</h1>
        <p class="donde-estas">{LUGARES.tapa}</p>
        <p id="subtitulo" class="tenue">{PANTALLA_0.subtitulo}</p>
        <button id="jugar" class="primario" type="button">{PANTALLA_0.boton}</button>
      </section>

      <section id="partida" class="pantalla sobre-tapa" hidden></section>
      <section id="resultado" class="pantalla sobre-tapa" hidden></section>

      <Caratula caratula={caratula} piezaSopla />
    </main>

    <PieImprenta disco="ultimo-bondi-a-finisterre" sinPasada tapas={tapasConCaratula(tapasUsadas, caratula)} />

    <script type="application/json" id="banco" set:html={JSON.stringify(items)} />
    <script>
      import '../../scripts/partida-tapa.ts';
    </script>

    <style>
      /* El cascaron —ancho, centrado, `position: relative` y el alto minimo de una
         ventana— vive en `juego.css` (`body > main`) desde el 2026-09-02: estaba copiado
         a mano en cinco paginas y en dos de ellas se habia desincronizado. */
      /* Esta pantalla viste Ultimo bondi (D-19, seccion discos). */
      /* El `h1` es uno solo para los ocho juegos desde el ciclo 17 (`juego.css`, `D-54`): la
         rotulada, sin negrita falsa, en la tinta del disco que la página viste. */
      .tenue {
        color: var(--texto-tenue);
      }
      .pantalla[hidden] {
        display: none;
      }
      .primario {
        display: block;
        width: 100%;
        margin-top: var(--espacio-4);
        padding: var(--espacio-2);
        min-height: var(--toque-min);
        font-family: var(--fuente-rotulada);
        /* El relleno ya no se escribe acá: es la tinta de Último bondi, que le pone
           `.juego--discos` (`D-54`). Era el rojo de la marca. */
        color: var(--fondo);
        border: none;
        border-radius: var(--radio);
        font-size: 1.25rem;
        /* Sin `font-weight`: Archivo Black tiene un solo peso y el 700 la engordaba
           sintética (`estilos.test.ts` lo mira). */
        letter-spacing: 0.04em;
      }
    </style>
  </body>
</html>
