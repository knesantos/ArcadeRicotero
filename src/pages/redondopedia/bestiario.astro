---
/**
 * El bestiario redondo (`D-73`): los bichos y la gente de las letras, en un mapa.
 *
 * Pedido del usuario: *"cada bestia en un entorno relacionado con ella y cerca de otras
 * bestias parecidas [...] un lugar que se puede recorrer desde arriba y entrar a ver el
 * entorno más en detalle"*. El mundo es redondo, como un disco: el galpón de Patricio Rey
 * en el medio, las regiones como porciones y la ruta del último bondi por el borde.
 *
 * ## Tres capas, y la de abajo alcanza sola
 *
 * 1. **El índice**, abajo de todo: cada bestia con su ficha entera, región por región, en
 *    HTML. Sin JavaScript se lee igual (molinetes abiertos), y es lo que encuentra un
 *    buscador.
 * 2. **El mapa**, un SVG armado en build (`lib/bestiario/mapa.ts` y `figuras.ts`). Cada
 *    figura es un `<symbol>`: el mapa y las fichas la usan con `<use>`.
 * 3. **La isla** (`scripts/bestiario.ts`): acerca el mapa a una región, recorre de una a
 *    otra, abre la ficha de una bestia copiándola del índice, hace sonar diez segundos del
 *    tema y anota en el teléfono las que ya abriste.
 *
 * ## Lo que pesa llega cuando se acerca (`T-445`)
 *
 * Cada escena de noche y cada retrato de un títere esperan en un `<noscript>`, con un SVG vacío
 * que les guarda el lugar (`lib/bestiario/carga.ts`). Sin JavaScript se dibujan como siempre; con
 * JavaScript la isla los arma recién a una pantalla y media. Así la página no baja las 59 piezas
 * (1673 kB) de una: arriba de todo baja solo el monte.
 *
 * La sección viste *Lobo suelto* (mitología, `D-19`) y el título va en su letra.
 */
import Base from '../../layouts/Base.astro';
import { BESTIARIO } from '../../lib/bestiario/copy.ts';
import { REDONDOPEDIA } from '../../lib/sitio/copy.ts';
import {
  LADO,
  dibujarRecinto,
  dibujarSuelo,
  lugarDelRotulo,
  polar,
  punto,
  simbolos,
  tintaDe,
  type Bestiario,
} from '../../lib/bestiario/mapa.ts';
import { ESCENA, escenaMonte } from '../../lib/bestiario/escena-monte.ts';
import { BARBAZUL, escenaBajo, escenaBaldio, escenaInfierno, escenaPrision, escenaTemplo, LUZBELITO, MOMO, PIERRE } from '../../lib/bestiario/escenas.ts';
import { ENTORNOS_DE_NOCHE } from '../../lib/bestiario/escenas-entornos.ts';
import { enEspera, SIN_ISLA } from '../../lib/bestiario/carga.ts';
import { PALO, marcoDelRecinto } from '../../lib/bestiario/rig.ts';
import { CON_CAMINO, hrefDeRegion, recintoDe } from '../../lib/bestiario/camino.ts';
import { EL_PLANO, VELOS, rutaDelVelo } from '../../lib/bestiario/velos.ts';
import { HITOS, cajaDelHito, cajaEnElPlano } from '../../lib/bestiario/arte-plano.ts';
import { LAS_DEL_PLANO, LUGAR_EN_EL_PLANO } from '../../lib/bestiario/plano-elenco.ts';
import { AUMENTO } from '../../lib/bestiario/mapa.ts';
import VeloDeLlegada from '../../components/bestiario/VeloDeLlegada.astro';
import FichaBestia from '../../components/bestiario/FichaBestia.astro';
import { loQueDice } from '../../lib/bestiario/fichas.ts';
import crudo from '../../data/bestiario.json';

const datos = crudo as unknown as Bestiario;
const { regiones, bestias } = datos;
const regionDe = new Map(regiones.map((r) => [r.id, r]));

/**
 * El recorrido: el orden en que se camina el zoológico. Arranca por el monte y la pastura,
 * que son un solo recinto (la pastura es un claro del monte), y da la vuelta al mundo
 * redondo hasta el galpón del medio. La ruta, que lo rodea todo, es la salida.
 */
const RECORRIDO = [
  'monte-pastura', 'la-mesa', 'los-techos', 'la-prision', 'el-infierno', 'el-bajo',
  'los-astilleros', 'el-templo', 'cybersiberia', 'el-arbol', 'el-galpon', 'la-ruta',
] as const;

const nombres = new Map(bestias.map((b) => [b.id, b.nombre]));

/** La primera región de un recinto que ya se camina (`D-73`, séptima vuelta): su puerta. */
const caminoDe = (recinto: string): string | undefined => CON_CAMINO.find((r) => recintoDe(r) === recinto);

const recintos = RECORRIDO.map((id) => {
  if (id === 'monte-pastura') {
    const monte = regionDe.get('el-monte')!;
    return {
      id,
      nombre: BESTIARIO.recintoMonte,
      canta: monte.canta,
      tinta: tintaDe(monte.disco),
      caja: `0 0 ${ESCENA.ancho} ${ESCENA.alto}`,
      foco: PALO.x,
      svg: escenaMonte(nombres),
      bestias: bestias.filter((b) => b.region === 'el-monte' || b.region === 'la-pastura'),
    };
  }
  const region = regionDe.get(id)!;
  // Los recintos de noche (D-73): los de protagonista de tapa, el bajo, con el gordo Pierre
  // pintado en la estética de *Gulp!*, y la prisión, con la drácula tallada como *Oktubre*. Cada
  // uno con su escena por capas. La décima vuelta suma los seis entornos que seguían con las
  // figuras del plano, cada uno en la tapa de su disco.
  // `foco`: dónde arranca mirando la escena cuando no entra entera (el perro entra por el borde).
  const deNoche: Record<string, { escena: (n: ReadonlyMap<string, string>) => string; foco: number }> = {
    // En el baldío, entre los dientes del perro y el Atila en la medianera: entran los dos.
    'los-techos': { escena: escenaBaldio, foco: 470 },
    'el-infierno': { escena: escenaInfierno, foco: LUZBELITO.x },
    'el-templo': { escena: escenaTemplo, foco: MOMO.argolla.x },
    'el-bajo': { escena: escenaBajo, foco: PIERRE.x - 60 },
    // La prisión arranca con Barbazul entero, que te recibe en la entrada, y la drácula enfrente.
    'la-prision': { escena: escenaPrision, foco: BARBAZUL.x + 110 },
    ...ENTORNOS_DE_NOCHE,
  };
  if (deNoche[id]) {
    return {
      id,
      nombre: region.nombre,
      canta: region.canta,
      tinta: tintaDe(region.disco),
      // Los recintos agrandados arrancan antes del cero (`MARCO_DEL_RECINTO`); el foco se cuenta desde el borde.
      caja: `${marcoDelRecinto(id).x} 0 ${marcoDelRecinto(id).ancho} ${ESCENA.alto}`,
      foco: deNoche[id]!.foco - marcoDelRecinto(id).x,
      svg: deNoche[id]!.escena(nombres),
      bestias: bestias.filter((b) => b.region === id),
    };
  }
  const { caja, svg } = dibujarRecinto(region, datos);
  return {
    id,
    nombre: region.nombre,
    canta: region.canta,
    tinta: tintaDe(region.disco),
    caja: `${caja.x.toFixed(1)} ${caja.y.toFixed(1)} ${caja.lado.toFixed(1)} ${caja.lado.toFixed(1)}`,
    svg,
    bestias: bestias.filter((b) => b.region === id),
  };
});

/** Las regiones en el orden del índice: el del recorrido, así la lista y el paseo no se contradicen. */
const ordenIndice = RECORRIDO.flatMap((id) => (id === 'monte-pastura' ? ['el-monte', 'la-pastura'] : [id])).map((id) => regionDe.get(id)!);

/** Lo que la isla necesita y no puede leer del HTML: el total y lo que dice cada bicho. */
const paraLaIsla = {
  total: bestias.length,
  bestias: bestias.map((b) => ({
    id: b.id,
    nombre: b.nombre,
    recinto: recintoDe(b.region),
    dice: loQueDice(b, BESTIARIO.sinTema),
  })),
};

/** El sello «Estás acá»: sobre la ruta, del lado del molinete del cartel, que es por donde se entra. */
const aca = (({ x, y }) => ({ x: (x / LADO) * 100, y: (y / LADO) * 100 }))(polar(162, 462));

const titulo = `${BESTIARIO.enLaPortada.titulo} — La Redondopedia — Fichín Ricotero`;
---

<Base
  titulo={titulo}
  descripcion={BESTIARIO.enLaPortada.resumen}
  volverA={{ href: '/redondopedia/', texto: REDONDOPEDIA.volverPortada }}
  discoDelPie="lobo-suelto"
  incrustable="/redondopedia/bestiario/"
>
  {/* Sin JavaScript, el <noscript> de cada escena y de cada retrato ya dibuja el de verdad: el que guarda el lugar se esconde. */}
  <Fragment set:html={SIN_ISLA} />
  {/* El velo con el que se llega al plano (`D-90`, octava ronda), y los de las regiones a las que se
      puede entrar desde acá, pedidos de antemano y sin apuro. */}
  <Fragment slot="cabeza">
    <link rel="preload" as="image" href={rutaDelVelo(EL_PLANO)} fetchpriority="high" />
    {CON_CAMINO.filter((r) => VELOS[r]).map((r) => <link rel="prefetch" as="image" href={rutaDelVelo(r)} />)}
  </Fragment>
  <VeloDeLlegada destino={EL_PLANO} />

  <div class="portada-redondopedia bestiario-portada">
    <h1 class="titulo-seccion bestiario-titulo">{BESTIARIO.titulo}</h1>
    {/* Tanda 6, segunda vuelta: acá iba una bajada de cuatro líneas que explicaba lo que ya dice la línea de abajo del plano.
        Queda la que canta y el contador, y el disco entra en la primera pantalla del teléfono. */}
    <p class="donde-estas">{BESTIARIO.dondeEstas}</p>
    <p class="bestiario-libreta" id="libreta" aria-live="polite">{BESTIARIO.libretaVacia(bestias.length)}</p>
  </div>

  {/* El plano del recorrido: el mundo redondo entero. Es la imagen; la navegación va por los
      rótulos, que son enlaces y llevan a caminar su región a pantalla completa (`D-77`). */}
  <section class="bestiario" id="plano" aria-label={BESTIARIO.plano}>
    {/* La entrada (`D-79`): el plano va clavado en un cartel, en la puerta de un mundo de noche.
        El fondo y el frente son imágenes impresas (`arte-portal.ts`); el plano sigue siendo el SVG. */}
    <div class="portal">
    <img class="portal-capa" src="/bestiario/portal-fondo.webp" alt="" width="1100" height="1606" decoding="async" />
    <div class="bestiario-marco" id="marco" data-vista="lejos">
      {/* La lente (`D-90`): lo que la lupa agranda. El marco es la ventana. */}
      <div class="bestiario-lente" id="lente">
      <svg id="mapa" class="bestiario-svg" viewBox={`0 0 ${LADO} ${LADO}`} aria-hidden="true">
        <defs set:html={simbolos(bestias)} />
        <g class="suelo" set:html={dibujarSuelo(datos)} />
        <g class="bestias">
          {
            // Tanda 6, segunda vuelta: dos por zona (`plano-elenco.ts`), impresas como títeres de cartón (`arte-plano.ts`).
            // Las 122 siguen en el recorrido, en los chips y en el índice; los `<symbol>` de arriba los siguen usando las fichas.
            bestias.filter((b) => LAS_DEL_PLANO.has(b.id)).map((b) => {
              const lugar = LUGAR_EN_EL_PLANO[b.id];
              const p = lugar ? polar(lugar[0], lugar[1]) : punto(b.pos);
              return (
                <g class="bestia-plano" data-id={b.id} style={`--tr: ${tintaDe(regionDe.get(b.region)!.disco)}`}>
                  <g class="marca-anotada" transform={`translate(${p.x + b.tam * 0.45} ${p.y - b.tam * 0.55})`}>
                    <circle r="7" class="b-pp b-borde" />
                    <path d="M-3.5 0 l2.5 3 l4.5 -6" class="b-tz" stroke-width="2.2" />
                  </g>
                </g>
              );
            })
          }
        </g>
      </svg>
      {/* El aire del plano (`D-91`, tanda 6, `arte-plano.ts`): las nubes que pasan por encima del disco y, muy cada tanto,
          la lechuza. Van arriba del dibujo y debajo de los carteles; no se tocan. Con la lupa se abren. */}
      {/* Los títeres (tercera vuelta): imágenes sueltas arriba del dibujo, no adentro del SVG, así se pueden hamacar desde
          el palito sin repintar el plano. Hoy están quietos (se midió el vaivén y no se leía: ver el estilo, abajo). */}
      {bestias.filter((b) => LAS_DEL_PLANO.has(b.id)).map((b, i) => {
        const lugar = LUGAR_EN_EL_PLANO[b.id];
        const caja = cajaEnElPlano(b, lugar ? polar(lugar[0], lugar[1]) : punto(b.pos), AUMENTO);
        return <img class="plano-titere" data-titere={b.id} src={`/bestiario/plano-titere-${b.id}.webp`} alt="" aria-hidden="true" width="326" height="350" decoding="async" style={`left: ${(caja.x / 10).toFixed(2)}%; top: ${(caja.y / 10).toFixed(2)}%; width: ${(caja.ancho / 10).toFixed(2)}%; --fase: ${((i * 0.53) % 3.4).toFixed(2)}s`} />;
      })}
      {/* Los hitos: lo que las tandas le sumaron a cinco regiones, en chiquito. Se leen con la lupa. */}
      {HITOS.map((h) => {
        const [x, y, lado] = cajaDelHito(h);
        return <img class="plano-hito" src={`/bestiario/plano-hito-${h.region}.webp`} alt="" aria-hidden="true" width="220" height="220" decoding="async" loading="lazy" style={`left: ${x / 10}%; top: ${y / 10}%; width: ${lado / 10}%`} />;
      })}
      <img class="plano-nubes" src="/bestiario/plano-nubes.webp" alt="" width="800" height="800" decoding="async" aria-hidden="true" />
      <div class="plano-aire" aria-hidden="true">
        <img class="plano-lechuza" src="/bestiario/plano-lechuza.webp" alt="" width="180" height="144" decoding="async" loading="lazy" />
      </div>
      <img class="portal-luz" src="/bestiario/portal-luz.webp" alt="" width="460" height="460" decoding="async" />

      <nav class="bestiario-rotulos" aria-label={BESTIARIO.regiones}>
        {
          regiones.map((r) => {
            const l = lugarDelRotulo(r, regiones);
            return (
              <a
                class={`rotulo-region rotulo-region--${r.id}`}
                href={hrefDeRegion(r.id)}
                style={`left: ${l.x}%; top: ${l.y}%; --tr: ${tintaDe(r.disco)}`}
                aria-label={r.nombre}
              >
                {r.corto}
              </a>
            );
          })
        }
      </nav>
      <p class="estas-aca" style={`left: ${aca.x}%; top: ${aca.y}%`}>{BESTIARIO.estasAca}</p>
      </div>
    </div>
    <img class="portal-capa portal-capa--frente" src="/bestiario/portal-frente.webp" alt="" width="1100" height="1606" decoding="async" />
    {/* La lupa: con el dedo, el pellizco y el doble toque; los botones, para el mouse y el teclado. */}
    <div class="lupa lupa--plano" id="lupa" role="group" aria-label={BESTIARIO.lupa.grupo} hidden>
      <button type="button" class="lupa-boton" id="lupa-todo" hidden>{BESTIARIO.lupa.todo}</button>
      <button type="button" class="lupa-boton lupa-signo" id="lupa-menos" aria-label={BESTIARIO.lupa.alejar}>−</button>
      <button type="button" class="lupa-boton lupa-signo" id="lupa-mas" aria-label={BESTIARIO.lupa.acercar}>+</button>
    </div>
    </div>
    <p class="bestiario-pie-plano">{BESTIARIO.alPlano}</p>
  </section>

  {/* El recorrido: un recinto detrás del otro, como un zoológico. */}
  <div class="recorrido">
    {
      recintos.map((rc, n) => (
        <section class="recinto" id={`recinto-${rc.id}`} aria-labelledby={`cartel-${rc.id}`} style={`--tr: ${rc.tinta}`}>
          <header class="recinto-cartel">
            <p class="recinto-numero">{BESTIARIO.recinto(n + 1)}</p>
            <h2 class="recinto-nombre" id={`cartel-${rc.id}`}>{rc.nombre}</h2>
            <p class="bestiario-canta">{rc.canta}</p>
          </header>
          {caminoDe(rc.id) && (
            <a class="recinto-camino" href={`/redondopedia/bestiario/${caminoDe(rc.id)}/#camino`}>{BESTIARIO.entrarCaminando}</a>
          )}
          <div
            class:list={['recinto-escena', `recinto-escena--${rc.id}`, { 'recinto-escena--noche': 'foco' in rc }]}
            data-recinto={rc.id}
            data-foco={'foco' in rc ? rc.foco : undefined}
          >
            {/* La escena espera en su <noscript> hasta que el recinto se acerca (T-445, carga.ts). */}
            <Fragment set:html={enEspera(`class="bestiario-svg recinto-svg" viewBox="${rc.caja}"`, rc.svg)} />
          </div>
          {'foco' in rc && <p class="recinto-deslizar" hidden>{BESTIARIO.deslizar}</p>}
          <p class="bestiario-sub">{BESTIARIO.aca}</p>
          <ul class="bestiario-chips">
            {rc.bestias.map((b) => (
              <li>
                <button type="button" class="bestiario-chip" data-ir={b.id}>{b.nombre}</button>
              </li>
            ))}
          </ul>
          <a class="recinto-volver" href="#plano">{BESTIARIO.volverAlPlano}</a>
        </section>
      ))
    }
  </div>

  {/* El bocadillo: lo que dice un bicho, con el mouse encima o solo (`D-78`). La isla lo lleva a su escena. */}
  <div class="bocadillo" id="bocadillo" hidden role="status">
    <p class="bocadillo-verso" id="bocadillo-verso"></p>
  </div>

  <div class="bestiario-hoja" id="hoja" hidden role="dialog" aria-modal="false" aria-labelledby="hoja-titulo">
    <button type="button" class="bestiario-cerrar" id="cerrar" aria-label={BESTIARIO.cerrar}>✕</button>
    <div id="hoja-cuerpo"></div>
  </div>

  <hr class="rodillo" aria-hidden="true" />

  <section class="bestiario-indice" aria-labelledby="indice">
    <h2 class="lado" id="indice">{BESTIARIO.indice.titulo}</h2>
    <p class="bajada-portal">{BESTIARIO.indice.bajada}</p>
    {
      ordenIndice.map((r) => (
        <section class="bestiario-region" style={`--tr: ${tintaDe(r.disco)}`} aria-labelledby={`region-${r.id}`}>
          <h3 class="bestiario-region-titulo" id={`region-${r.id}`}>{r.nombre}</h3>
          <p class="bestiario-canta">{r.canta}</p>
          <ul class="bestiario-lista">
            {bestias
              .filter((b) => b.region === r.id)
              .map((b) => (
                <FichaBestia bestia={b} tinta={tintaDe(r.disco)} nombres={nombres} hrefCerca={(id) => `#b-${id}`} conMapa espera />
              ))}
          </ul>
        </section>
      ))
    }
  </section>

  <script type="application/json" id="datos-bestiario" set:html={JSON.stringify(paraLaIsla)} />
  <script>
    import '../../scripts/bestiario.ts';

    // Bajar a una región (`D-91`, tanda 6): al tocar un cartel, las nubes del borde se cierran sobre el plano mientras
    // llega la página de la región. No demora nada: el enlace sigue su camino. Al volver, se abren.
    const marco = document.getElementById('marco');
    for (const cartel of document.querySelectorAll('.rotulo-region')) cartel.addEventListener('click', () => marco?.classList.add('bestiario-marco--baja'));
    window.addEventListener('pageshow', () => marco?.classList.remove('bestiario-marco--baja'));
  </script>
</Base>

<style>
  /* El aire del plano (`D-91`, tanda 6). Va acá y no en `sitio.css` porque es solo de esta página, y esa hoja la está
     tocando otra rama (`T-529`). Solo `transform` y `opacity`, sobre dos imágenes sueltas: el dibujo del plano no se repinta. */
  .plano-aire {
    position: absolute;
    inset: 1.4%;
    border-radius: 50%;
    overflow: hidden;
    pointer-events: none;
    transition: opacity 0.5s;
  }

  /* Las nubes están quietas. En la primera versión daban la vuelta con el disco, una cada cinco minutos: no se llegaba a
     ver que giraban y, medido contra main en ocho tandas, el plano costaba entre un 6 % y un 95 % más por cuadro, con el
     recorte redondo y sin él. Una capa que se mueve siempre obliga a componer el plano entero en cada cuadro. Quietas no
     cuestan; lo único que les pasa es que se abren con la lupa. */
  .plano-nubes {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.8;
    transition: opacity 0.5s, transform 0.4s;
  }

  /* Los títeres: sueltos, sin toque, y con el eje en el palito. Están quietos. En la tercera vuelta se hamacaron con la
     lupa puesta (2,8° para cada lado, cada uno a su tiempo): medido a ×4 contra el mismo plano quieto, costaba de un 7 a
     un 28 % por cuadro, y en la tira de seis cuadros no se leía. Lo que se mueve y no se lee vuelve a quieto. Quedan
     sueltos y con el eje puesto: si algún día se hamacan, es una regla acá y nada más. */
  .plano-titere {
    position: absolute;
    height: auto;
    pointer-events: none;
    transform-origin: 50% 96%;
  }

  /* Los hitos van con el dibujo: chicos, quietos, sin toque. */
  .plano-hito {
    position: absolute;
    height: auto;
    pointer-events: none;
  }

  /* Bajar a una región: las nubes del borde se cierran sobre el disco. */
  :global(.bestiario-marco--baja) .plano-nubes {
    opacity: 1;
    transform: scale(0.34) rotate(40deg);
  }

  /* La lechuza cruza de abajo a la izquierda hacia arriba a la derecha en unos nueve segundos, una vez cada tres cuartos de minuto. */
  .plano-lechuza {
    position: absolute;
    left: 0;
    top: 0;
    width: 15%;
    height: auto;
    opacity: 0;
    animation: plano-cruza 46s linear 9s infinite;
  }

  /* Con la lupa puesta, acercarse es meterse abajo de las nubes: se abren del todo. */
  :global(.bestiario-marco--lupa) .plano-nubes,
  :global(.bestiario-marco--lupa) .plano-aire {
    opacity: 0;
  }

  @keyframes plano-cruza {
    0% {
      transform: translate(-120%, 540%) rotate(-25deg);
      opacity: 0;
    }
    1.5% {
      opacity: 0.94;
    }
    19% {
      opacity: 0.94;
    }
    20.5%,
    100% {
      transform: translate(720%, 130%) rotate(-25deg);
      opacity: 0;
    }
  }

  /* Con movimiento reducido la lechuza no pasa y las nubes no se cierran. */
  @media (prefers-reduced-motion: reduce) {
