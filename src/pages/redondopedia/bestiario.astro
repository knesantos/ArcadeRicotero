---
/**
 * El bestiario redondo (`D-73`): los bichos y la gente de las letras, en un mapa.
 *
 * Pedido del usuario: *"cada bestia en un entorno relacionado con ella y cerca de otras
 * bestias parecidas [...] un lugar que se puede recorrer desde arriba y entrar a ver el
 * entorno más en detalle"*. El mundo es redondo, como un disco: el galpón de Patricio Rey
 * en el medio, las regiones como porciones y la ruta del último bondi por el borde.
 *
 * ## Tres capas, y la de abajo alcanza sola
 *
 * 1. **El índice**, abajo de todo: cada bestia con su ficha entera, región por región, en
 *    HTML. Sin JavaScript se lee igual (molinetes abiertos), y es lo que encuentra un
 *    buscador.
 * 2. **El mapa**, un SVG armado en build (`lib/bestiario/mapa.ts` y `figuras.ts`). Cada
 *    figura es un `<symbol>`: el mapa y las fichas la usan con `<use>`.
 * 3. **La isla** (`scripts/bestiario.ts`): acerca el mapa a una región, recorre de una a
 *    otra, abre la ficha de una bestia copiándola del índice, hace sonar diez segundos del
 *    tema y anota en el teléfono las que ya abriste.
 *
 * La sección viste *Lobo suelto* (mitología, `D-19`) y el título va en su letra.
 */
import Base from '../../layouts/Base.astro';
import { BESTIARIO } from '../../lib/bestiario/copy.ts';
import { REDONDOPEDIA } from '../../lib/sitio/copy.ts';
import {
  LADO,
  camara,
  cajaDeFigura,
  dibujarSuelo,
  lugarDelRotulo,
  punto,
  simbolos,
  tintaDe,
  type Bestiario,
  type Bestia,
} from '../../lib/bestiario/mapa.ts';
import { tituloDelDisco } from '../../lib/letra/discos.ts';
import { indexarFragmentos, type Manifiesto } from '../../lib/tema/catalogo.ts';
import { leerTemas, slugDeTitulo } from '../../lib/letra/temas.ts';
import manifiesto from '../../data/adivinar-tema.json';
import cancionero from '../../data/cancionero.json';
import crudo from '../../data/bestiario.json';

const datos = crudo as unknown as Bestiario;
const { regiones, bestias } = datos;
const regionDe = new Map(regiones.map((r) => [r.id, r]));
const bestiaDe = new Map(bestias.map((b) => [b.id, b]));

/** Los temas del cancionero, por slug: título, disco y año para el "Sale en". */
const temas = new Map(cancionero.temas.map((t) => [t.slug, { titulo: t.titulo, disco: t.disco, anio: t.anio }]));
/** Qué temas tienen recorte: los 105 de `RES-20`, como en "En vivo". El slug es el mismo del cancionero. */
const slugs105 = new Set(leerTemas().map((t) => slugDeTitulo(t.titulo)));
const conAudio = new Set(indexarFragmentos(manifiesto as unknown as Manifiesto, slugs105).keys());

const saleEn = (slug: string): string => {
  const t = temas.get(slug)!;
  return `«${t.titulo}» (${tituloDelDisco(t.disco)}, ${t.anio})`;
};

const etiquetaRotulo = (c: NonNullable<Bestia['cuenta']>[number]): string =>
  c.rotulo === 'leyenda' ? 'Leyenda' : `Lo contó ${c.quien ?? 'alguien'}`;

/** Las regiones en el orden del índice: del centro para afuera, y la ruta al final. */
const ordenIndice = [...regiones];

/** Lo que la isla necesita y no puede leer del HTML: cámaras, vecinas, posiciones. */
const paraLaIsla = {
  total: bestias.length,
  regiones: regiones.map((r) => ({
    id: r.id,
    nombre: r.nombre,
    canta: r.canta,
    vecinas: r.vecinas,
    camara: camara(r, bestias),
  })),
  bestias: bestias.map((b) => ({ id: b.id, nombre: b.nombre, region: b.region, ...punto(b.pos) })),
};

const titulo = `${BESTIARIO.enLaPortada.titulo} — La Redondopedia — Fichín Ricotero`;
---

<Base
  titulo={titulo}
  descripcion={BESTIARIO.enLaPortada.resumen}
  volverA={{ href: '/redondopedia/', texto: REDONDOPEDIA.volverPortada }}
  discoDelPie="lobo-suelto"
>
  <div class="portada-redondopedia bestiario-portada">
    <h1 class="titulo-seccion bestiario-titulo">{BESTIARIO.titulo}</h1>
    <p class="donde-estas">{BESTIARIO.dondeEstas}</p>
    <p class="bajada-portal">{BESTIARIO.bajada(bestias.length)}</p>
    <p class="bestiario-libreta" id="libreta" aria-live="polite">{BESTIARIO.libretaVacia(bestias.length)}</p>
  </div>

  <section class="bestiario" aria-label={BESTIARIO.mapa}>
    <div class="bestiario-marco" id="marco" data-vista="lejos">
      <svg
        id="mapa"
        class="bestiario-svg"
        viewBox={`0 0 ${LADO} ${LADO}`}
        role="group"
        aria-label={BESTIARIO.mapa}
      >
        <defs set:html={simbolos(bestias)} />
        <g class="suelo" aria-hidden="true" set:html={dibujarSuelo(datos)} />
        <g class="bestias">
          {
            bestias.map((b) => {
              const caja = cajaDeFigura(b);
              const p = punto(b.pos);
              return (
                <g
                  class="bestia"
                  data-id={b.id}
                  data-region={b.region}
                  role="button"
                  tabindex="-1"
                  aria-label={b.nombre}
                  style={`--tr: ${tintaDe(regionDe.get(b.region)!.disco)}`}
                >
                  <circle class="toque" cx={p.x} cy={p.y} r={Math.max(b.tam * 0.62, 20)} />
                  <use href={`#fig-${b.id}`} x={caja.x} y={caja.y} width={caja.ancho} height={caja.alto} />
                  <g class="marca-anotada" transform={`translate(${p.x + b.tam * 0.45} ${p.y - b.tam * 0.55})`}>
                    <circle r="7" class="b-pp b-borde" />
                    <path d="M-3.5 0 l2.5 3 l4.5 -6" class="b-tz" stroke-width="2.2" />
                  </g>
                </g>
              );
            })
          }
        </g>
      </svg>

      {/* Los rótulos del mapa entero son botones de verdad: se llega con el teclado y los lee
          el lector de pantalla. El SVG es la imagen; la navegación va por acá. */}
      <nav class="bestiario-rotulos" aria-label={BESTIARIO.regiones}>
        {
          regiones.map((r) => {
            const l = lugarDelRotulo(r);
            return (
              <button
                type="button"
                class={`rotulo-region rotulo-region--${r.id}`}
                data-region={r.id}
                style={`left: ${l.x}%; top: ${l.y}%; --tr: ${tintaDe(r.disco)}`}
                aria-label={r.nombre}
              >
                {r.corto}
              </button>
            );
          })
        }
      </nav>
    </div>

    <div class="bestiario-barra" id="barra" hidden>
      <p class="bestiario-aqui">
        <span class="bestiario-aqui-etiqueta">{BESTIARIO.estasEn}</span>
        <strong id="aqui"></strong>
      </p>
      <p class="bestiario-canta" id="aqui-canta"></p>
      <button type="button" class="bestiario-volver" id="volver-al-mapa">← {BESTIARIO.volverAlMapa}</button>
      <p class="bestiario-sub">{BESTIARIO.aca}</p>
      <ul class="bestiario-chips" id="aca"></ul>
      <p class="bestiario-sub">{BESTIARIO.alLado}</p>
      <ul class="bestiario-chips bestiario-chips--vecinas" id="al-lado"></ul>
    </div>
  </section>

  <div class="bestiario-hoja" id="hoja" hidden role="dialog" aria-modal="false" aria-labelledby="hoja-titulo">
    <button type="button" class="bestiario-cerrar" id="cerrar" aria-label={BESTIARIO.cerrar}>✕</button>
    <div id="hoja-cuerpo"></div>
  </div>

  <hr class="rodillo" aria-hidden="true" />

  <section class="bestiario-indice" aria-labelledby="indice">
    <h2 class="lado" id="indice">{BESTIARIO.indice.titulo}</h2>
    <p class="bajada-portal">{BESTIARIO.indice.bajada}</p>
    {
      ordenIndice.map((r) => (
        <section class="bestiario-region" style={`--tr: ${tintaDe(r.disco)}`} aria-labelledby={`region-${r.id}`}>
          <h3 class="bestiario-region-titulo" id={`region-${r.id}`}>{r.nombre}</h3>
          <p class="bestiario-canta">{r.canta}</p>
          <ul class="bestiario-lista">
            {bestias
              .filter((b) => b.region === r.id)
              .map((b) => (
                <li id={`b-${b.id}`} class="bestiario-item" data-id={b.id}>
                  <details class="bestiario-ficha" data-bestia={b.id}>
                    <summary>
                      <svg class="bestiario-mini" viewBox="-10 -15 120 115" aria-hidden="true" style={`--tr: ${tintaDe(r.disco)}`}>
                        <use href={`#fig-${b.id}`} />
                      </svg>
                      <span class="bestiario-nombre">{b.nombre}</span>
                      <span class="bestiario-anotada-sello">{BESTIARIO.anotada}</span>
                    </summary>
                    <div class="bestiario-cuerpo" style={`--tr: ${tintaDe(r.disco)}`}>
                      <p class="bestiario-sello">{BESTIARIO.clases[b.clase]}</p>
                      <h4 class="bestiario-ficha-titulo" data-titulo>{b.nombre}</h4>
                      <svg class="bestiario-figura" viewBox="-10 -15 120 115" aria-hidden="true">
                        <use href={`#fig-${b.id}`} />
                      </svg>

                      {b.tema ? (
                        <>
                          <p class="bestiario-sale">
                            <span class="bestiario-sub">{BESTIARIO.saleEn}</span> {saleEn(b.tema)}
                          </p>
                          <blockquote class="bestiario-verso">
                            {b.verso!.map((v) => <span>{v}</span>)}
                          </blockquote>
                        </>
                      ) : (
                        <p class="bestiario-sale">{BESTIARIO.sinTema}</p>
                      )}
                      {(b.tambien ?? []).map((t) => (
                        <p class="bestiario-tambien">
                          <span class="bestiario-sub">{BESTIARIO.tambienEn}</span> {saleEn(t.tema)}: «{t.verso.join(' / ')}»
                        </p>
                      ))}

                      <p class="bestiario-sub">{BESTIARIO.laEstampa}</p>
                      <p class="bestiario-estampa">{b.estampa}</p>

                      {b.cuenta && b.cuenta.length > 0 && (
                        <>
                          <p class="bestiario-sub">{BESTIARIO.seCuenta}</p>
                          {b.cuenta.map((c) => (
                            <p class={`parrafo parrafo--${c.rotulo}`}>
                              {c.rotulo !== 'hecho' && <span class="marca-rotulo">{etiquetaRotulo(c)}</span>}
                              {c.texto}
                              {c.fuente && <span class="fuente-chip"> — {c.rotulo === 'hecho' ? 'hecho · ' : ''}{c.fuente}</span>}
                            </p>
                          ))}
                        </>
                      )}

                      <div class="bestiario-acciones">
                        {b.tema && conAudio.has(b.tema) && (
                          <button type="button" class="bestiario-escuchar" data-escuchar={b.tema}>
                            {BESTIARIO.escuchar}
                          </button>
                        )}
                        {b.tema && <a href={`/letras-y-acordes/${b.tema}/`}>{BESTIARIO.leerLetra}</a>}
                        {b.articulo && <a href={`/redondopedia/${b.articulo}/`}>{BESTIARIO.leerArticulo}</a>}
                        <button type="button" class="bestiario-ver solo-indice" data-ver={b.id}>
                          {BESTIARIO.verEnElMapa}
                        </button>
                      </div>

                      <p class="bestiario-sub">{BESTIARIO.andaCerca}</p>
                      <ul class="bestiario-chips">
                        {b.cerca.map((id) => (
                          <li>
                            <a class="bestiario-chip" href={`#b-${id}`} data-ir={id}>
                              {bestiaDe.get(id)!.nombre}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </details>
                </li>
              ))}
          </ul>
        </section>
      ))
    }
  </section>

  <script type="application/json" id="datos-bestiario" set:html={JSON.stringify(paraLaIsla)} />
  <script>
    import '../../scripts/bestiario.ts';
  </script>
</Base>
