---
/**
 * "En vivo": los recitales en pantalla (`IDEA-15`, `D-72`).
 *
 * Tres bloques, cada uno con el régimen de su dato (`CTR-19.1`):
 *
 * 1. **Las listas enteras** de `recitales.json` (la pieza 2), que el sitio puede copiar
 *    porque su fuente las da bajo CC0 (`RES-78`). Cada una lleva en el mismo bloque lo que
 *    pide `RNF-CTR-19-B`: la fuente con el enlace a ese recital, la licencia de la fuente, qué
 *    le hizo el sitio, bajo qué licencia la ofrece y si la fuente dice que está completa.
 * 2. **Lo que más aparece** en las listas de setlist.fm, del conteo citado de
 *    `setlistfm.json` (la pieza 1). Con `RNF-CTR-19-A` al lado: qué mide, de dónde sale y
 *    cuándo se consultó, y "figura", nunca "se tocó".
 * 3. **El índice** de las noches que el sitio tiene de setlist.fm: fecha, lugar y enlace. La
 *    lista no se copia: setlist.fm deja mirarla, no copiarla (`RES-73.1`).
 *
 * **Esta página es la única que lee la pieza 2** (`CTR-19.8`, regla 4, enmendada por
 * `D-72`). Hasta acá ningún módulo la leía, para que el "compartir igual" de una licencia no
 * alcanzara a nada más. La fuente única del archivo es CC0 y la salida es CC0: no hay nada
 * que compartir igual, y el borde se cruza con los rótulos puestos. `en-vivo.test.ts` (t8)
 * deja leerla a este archivo y a ninguno más.
 *
 * Cada tema con recorte suena al tocarlo, y cada lista entera suena de punta a punta, diez
 * segundos por tema (`scripts/en-vivo.ts`, con la rocola de `D-72`).
 */
import Base from '../../layouts/Base.astro';
import { REDONDOPEDIA } from '../../lib/sitio/copy.ts';
import { EN_VIVO } from '../../lib/recital/copy.ts';
import { fondoTapa, discosDe } from '../../lib/sitio/arte.ts';
import { leerTemas, slugDeTitulo } from '../../lib/letra/temas.ts';
import { indexarFragmentos, type Manifiesto } from '../../lib/tema/catalogo.ts';
import { fechaLarga, fechaDeConsulta, bisDeLaNota, porAnio, nombreDeLicencia } from '../../lib/recital/listas.ts';
import manifiesto from '../../data/adivinar-tema.json';
import setlistfm from '../../data/setlistfm.json';
import archivo from '../../data/recitales.json';

const fondoCabecera = fondoTapa('gulp-pincelada');
const tapasUsadas = fondoCabecera ? discosDe(['gulp-pincelada']) : [];

const temas = leerTemas();
const slugs = new Set(temas.map((t) => slugDeTitulo(t.titulo)));
const conAudio = new Set(indexarFragmentos(manifiesto as unknown as Manifiesto, slugs).keys());

interface TemaDeLista {
  readonly titulo: string;
  readonly slug?: string;
  readonly fuera?: string;
  readonly nota?: string;
}

/** Una lista entera, con el bis que marca la fuente adelante de cada tema que abre uno. */
const enteras = archivo.recitales.map((r, n) => {
  const fuente = archivo.fuentes.find((f) => f.id === r.fuente)!;
  let bisAnterior: number | null = null;
  const filas = (r.temas as readonly TemaDeLista[]).map((t) => {
    const bis = bisDeLaNota(t.nota);
    const abreBis = bis !== null && bis !== bisAnterior ? bis : null;
    bisAnterior = bis;
    const suena = t.slug && conAudio.has(t.slug) ? t.slug : null;
    return { ...t, abreBis, suena };
  });
  return {
    id: `lista-${n + 1}`,
    fecha: r.fecha,
    encabezado: EN_VIVO.enteras.encabezado(fechaLarga(r.fecha), r.lugar, r.ciudad),
    url: r.url,
    completitud: EN_VIVO.enteras.completitud[r.completitud] ?? EN_VIVO.enteras.completitud['sin-declarar']!,
    fuente,
    // `D-72`: la fuente avisa que nadie revisó sus listas (Discogs). Va en el resumen y en el rótulo.
    sinRevisar: 'revision' in fuente && fuente.revision === 'sin-revisar',
    nota: 'nota' in r ? (r.nota as string) : null,
    licenciaFuente: nombreDeLicencia(fuente.licencia.familia, fuente.licencia.version),
    filas,
    cuantos: filas.length,
  };
});
/** Por año: con veintisiete noches, la página se recorre por la fecha y cada lista se abre al tocarla. */
const enterasPorAnio = [...porAnio(enteras).entries()];
const salida = { nombre: nombreDeLicencia(archivo.licencia.id), url: archivo.licencia.url };

/** Lo que más aparece: los primeros a la vista, y el resto plegado. */
const VISIBLES = 15;
const conteo = setlistfm.conteo.temas.map((t) => {
  const slug = 'slug' in t ? (t.slug as string) : undefined;
  return { ...t, slug, suena: slug && conAudio.has(slug) ? slug : null };
});
const primeros = conteo.slice(0, VISIBLES);
const resto = conteo.slice(VISIBLES);
const consultado = fechaDeConsulta(setlistfm.conteo.consultado);

const indice = [...porAnio(setlistfm.indice).entries()];
---

<Base
  titulo={`${EN_VIVO.titulo} — La Redondopedia — Fichín Ricotero`}
  descripcion={EN_VIVO.enLaPortada.resumen}
  volverA={{ href: '/redondopedia/', texto: REDONDOPEDIA.volverPortada }}
  tapas={tapasUsadas}
  discoDelPie="gulp"
>
  <div class="portada-redondopedia en-vivo-portada">
    {fondoCabecera && <div class="tapa-fondo tapa-fondo--gulp-pincelada" aria-hidden="true" />}
    <h1 class="titulo-seccion">{EN_VIVO.titulo}</h1>
    <p class="donde-estas">{EN_VIVO.dondeEstas}</p>
    <p class="bajada-portal">{EN_VIVO.bajada}</p>
    {/* Es una página larga: los tres bloques y el juego, a un toque desde arriba. */}
    <nav class="en-vivo-saltos" aria-label={EN_VIVO.saltos}>
      <a href="#enteras">{EN_VIVO.enteras.titulo}</a>
      <a href="#mas">{EN_VIVO.mas.titulo}</a>
      <a href="#indice">{EN_VIVO.indice.titulo}</a>
      <a href="/juegos/arma-tu-recital/">{EN_VIVO.armala}</a>
    </nav>
  </div>

  <section class="en-vivo-bloque" aria-labelledby="enteras">
    <h2 class="lado" id="enteras">{EN_VIVO.enteras.titulo}</h2>
    {
      enterasPorAnio.map(([anio, delAnio]) => (
        <section class="en-vivo-anio" aria-label={anio}>
          <h3 class="en-vivo-anio-titulo">{anio}</h3>
          {delAnio.map((r) => (
        <details class="en-vivo-entera" id={r.id}>
          <summary class="en-vivo-encabezado">
            <span>{r.encabezado}</span>
            <span class="en-vivo-cuantos">{EN_VIVO.enteras.temas(r.cuantos)}</span>
            {r.sinRevisar && <span class="en-vivo-sello">{EN_VIVO.enteras.selloSinRevisar}</span>}
          </summary>
          <button
            class="en-vivo-escuchar"
            type="button"
            data-lista={r.id}
            data-escuchar={EN_VIVO.enteras.escuchar}
            data-parar={EN_VIVO.enteras.parar}
          >
            {EN_VIVO.enteras.escuchar}
          </button>
          <p class="en-vivo-como-suena">{EN_VIVO.enteras.comoSuena}</p>
          <ol class="en-vivo-lista">
            {r.filas.map((t) => (
              <>
                {t.abreBis !== null && <li class="en-vivo-bis" aria-hidden="true">{EN_VIVO.enteras.bis(t.abreBis)}</li>}
                <li class="en-vivo-tema" data-suena={t.suena ?? undefined}>
                  <span class="en-vivo-titulo">
                    {t.abreBis !== null && <span class="en-vivo-oculto">{EN_VIVO.enteras.bis(t.abreBis)}: </span>}
                    {t.titulo}
                  </span>
                  {t.fuera && <span class="en-vivo-fuera">{EN_VIVO.enteras.fuera[t.fuera] ?? EN_VIVO.enteras.fuera['sin-identificar']}</span>}
                  {t.suena ? (
                    <button class="en-vivo-play" type="button" data-slug={t.suena} aria-label={`${EN_VIVO.enteras.corto} ${t.titulo}`} aria-pressed="false" data-escuchar={EN_VIVO.enteras.corto} data-parar={EN_VIVO.enteras.parar}>{EN_VIVO.enteras.corto}</button>
                  ) : (
                    !t.fuera && <span class="en-vivo-sin">{EN_VIVO.enteras.sinRecorte}</span>
                  )}
                </li>
              </>
            ))}
          </ol>
          <dl class="en-vivo-rotulo">
            {r.sinRevisar && (
              <>
                <dt>{EN_VIVO.enteras.revision}</dt>
                <dd>{EN_VIVO.enteras.textoSinRevisar}</dd>
              </>
            )}
            {r.nota && (
              <>
                <dt>{EN_VIVO.enteras.aviso}</dt>
                <dd>{r.nota}</dd>
              </>
            )}
            <dt>{EN_VIVO.enteras.fuente}</dt>
            <dd>
              <a href={r.fuente.sitio} rel="noopener">{r.fuente.nombre}</a>,{' '}
              <a href={r.url} rel="noopener">{EN_VIVO.enteras.paginaDelRecital}</a>.
            </dd>
            <dt>{EN_VIVO.enteras.licenciaDeLaFuente}</dt>
            <dd><a href={r.fuente.licencia.url} rel="noopener">{r.licenciaFuente}</a>.</dd>
            <dt>{EN_VIVO.enteras.cambios}</dt>
            <dd>{archivo.cambios}</dd>
            <dt>{EN_VIVO.enteras.ofrecida}</dt>
            <dd><a href={salida.url} rel="noopener">{salida.nombre}</a>.</dd>
          </dl>
          <p class="en-vivo-rotulo en-vivo-rotulo-suelto">{r.completitud}</p>
        </details>
          ))}
        </section>
      ))
    }
  </section>

  <hr class="rodillo" aria-hidden="true" />

  <section class="en-vivo-bloque" aria-labelledby="mas">
    <h2 class="lado" id="mas">{EN_VIVO.mas.titulo}</h2>
    <p class="en-vivo-rotulo-conteo">
      {EN_VIVO.mas.rotulo(setlistfm.conteo.setlistsCargados, consultado)}{' '}
      <a href={setlistfm.conteo.pagina} rel="noopener">{EN_VIVO.mas.enlace}</a>.
    </p>
    {/* `ul` y no `ol`: el puesto no se guarda ni se muestra (`CTR-19.3`, `REV-23` `FIND-162`). */}
    <ul class="en-vivo-lista en-vivo-lista--conteo">
      {primeros.map((t) => (
        <li class="en-vivo-tema" data-suena={t.suena ?? undefined}>
          <span class="en-vivo-titulo">{t.titulo}</span>
          <span class="en-vivo-veces">{EN_VIVO.mas.veces(t.veces)}</span>
          {'fuera' in t && t.fuera && <span class="en-vivo-fuera">{EN_VIVO.enteras.fuera[t.fuera as string]}</span>}
          {t.suena && (
            <button class="en-vivo-play" type="button" data-slug={t.suena} aria-label={`${EN_VIVO.enteras.corto} ${t.titulo}`} aria-pressed="false" data-escuchar={EN_VIVO.enteras.corto} data-parar={EN_VIVO.enteras.parar}>{EN_VIVO.enteras.corto}</button>
          )}
        </li>
      ))}
    </ul>
    {resto.length > 0 && (
      <details class="en-vivo-resto">
        <summary>{EN_VIVO.mas.losDemas(resto.length)}</summary>
        <ul class="en-vivo-lista en-vivo-lista--conteo">
          {resto.map((t) => (
            <li class="en-vivo-tema" data-suena={t.suena ?? undefined}>
              <span class="en-vivo-titulo">{t.titulo}</span>
              <span class="en-vivo-veces">{EN_VIVO.mas.veces(t.veces)}</span>
              {'fuera' in t && t.fuera && <span class="en-vivo-fuera">{EN_VIVO.enteras.fuera[t.fuera as string]}</span>}
              {t.suena && (
                <button class="en-vivo-play" type="button" data-slug={t.suena} aria-label={`${EN_VIVO.enteras.corto} ${t.titulo}`} aria-pressed="false" data-escuchar={EN_VIVO.enteras.corto} data-parar={EN_VIVO.enteras.parar}>{EN_VIVO.enteras.corto}</button>
              )}
            </li>
          ))}
        </ul>
      </details>
    )}
  </section>

  <hr class="rodillo" aria-hidden="true" />

  <section class="en-vivo-bloque" aria-labelledby="indice">
    <h2 class="lado" id="indice">{EN_VIVO.indice.titulo}</h2>
    <p class="en-vivo-rotulo-conteo">{EN_VIVO.indice.rotulo}</p>
    {
      indice.map(([anio, noches]) => (
        <section class="en-vivo-anio" aria-label={anio}>
          <h3 class="en-vivo-anio-titulo">{anio}</h3>
          <ul class="en-vivo-noches">
            {noches.map((n) => (
              <li>
                <span>{fechaLarga(n.fecha)} · {n.lugar}, {n.ciudad}</span>
                <a href={n.url} rel="noopener">{EN_VIVO.indice.enlace}</a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </section>

  <a class="accion-abajo en-vivo-armala" href="/juegos/arma-tu-recital/">{EN_VIVO.armala}</a>
  <p class="en-vivo-oculto" id="en-vivo-aviso" aria-live="polite"></p>

  <script>
    import '../../scripts/en-vivo.ts';
  </script>
</Base>
