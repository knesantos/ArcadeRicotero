---
/**
 * El camino con cruces (`D-73`, séptima vuelta): una región del bestiario que se camina.
 *
 * Pedido del usuario: *"una página por región, scroll que camina de costado y flechas en el
 * cruce. Arrancá por el monte y la pastura como prueba."* Desde `D-77` son las trece: *"todos los
 * entornos deben ser caminables y conectados"*. Cada tramo de `lib/bestiario/camino.ts` es una
 * página. Se desliza de costado y la escena se camina, en capas que se corren a distinta
 * velocidad donde las hay; los bichos aparecen a medida que se llega a ellos, y al final hay un
 * cruce con un cartel por cada región vecina (`vecinas` en el JSON), con la flecha para el lado
 * donde queda en el plano redondo.
 *
 * El piso de cada forma de tramo (largo, entorno, recinto) lo arma `lib/bestiario/escenas-camino.ts`.
 *
 * ## Tres capas, como el bestiario, y la de abajo alcanza sola
 *
 * 1. **Sin JavaScript**, la escena es una tira que se corre de costado con el dedo, el cruce
 *    está al final de la tira y las fichas abajo: se lee y se recorre igual (molinetes abiertos).
 * 2. **Con movimiento reducido**, la pantalla entera igual, pero nada se mueve solo y las capas
 *    van juntas.
 * 3. **La isla** (`scripts/camino.ts`) lleva la escena a la pantalla entera y la camina con el
 *    scroll de costado.
 *
 * Al pasar de una región a otra, la página cambia con el tránsito entre documentos de todo el
 * sitio (`ADR-03`), sin una línea de JavaScript.
 *
 * ## La pantalla entera (`D-76`, `D-77`)
 *
 * Pedido del usuario: *"el entorno caminable debe ser lo principal del bestiario, arrancar ahí y
 * que para salir debas tocar algo"*, y *"siempre en pantalla completa"*. Con la isla andando, el
 * camino es la página entera: el cartel y los botones flotan arriba, la lista y la ficha flotan
 * encima sin tapar la escena entera, y se sale por "Al plano" o por un cartel del cruce.
 *
 * Y suena de lejos un disco (`lib/bestiario/sonido.ts`), prendido desde que se entra.
 */
import Base from '../../../layouts/Base.astro';
import FichaBestia from '../../../components/bestiario/FichaBestia.astro';
import { BESTIARIO, CAMINO } from '../../../lib/bestiario/copy.ts';
import { lugarDelRotulo, simbolos, tintaDe, type Bestiario, type Bestia } from '../../../lib/bestiario/mapa.ts';
import { ALTO, CAMINOS, CON_CAMINO, hrefDeRegion } from '../../../lib/bestiario/camino.ts';
import { PIEZAS_CAMINO } from '../../../lib/bestiario/arte-camino.ts';
import { rutaDePieza } from '../../../lib/bestiario/aerografo.ts';
import { pisoDelCamino } from '../../../lib/bestiario/escenas-camino.ts';
import { conAudio, loQueDice } from '../../../lib/bestiario/fichas.ts';
import { fondoDe } from '../../../lib/bestiario/sonido.ts';
import { tituloDelDisco } from '../../../lib/letra/discos.ts';
import { urlDeFragmento } from '../../../lib/audio/rutas-de-audio.ts';
import crudo from '../../../data/bestiario.json';
import cancionero from '../../../data/cancionero.json';
import '../../../styles/camino.css';

export function getStaticPaths() {
  return CON_CAMINO.map((region) => ({ params: { region } }));
}

const { region: id } = Astro.params as { region: string };
const tramo = CAMINOS[id]!;
const datos = crudo as unknown as Bestiario;
const regionDe = new Map(datos.regiones.map((r) => [r.id, r]));
const region = regionDe.get(id)!;
const tinta = tintaDe(region.disco);
const nombres = new Map(datos.bestias.map((b) => [b.id, b.nombre]));
const bestiaDe = new Map(datos.bestias.map((b) => [b.id, b]));

/** Los que andan por el camino: los de la región, y los de visita (el lobo en la pastura). */
const deLaRegion = datos.bestias.filter((b) => b.region === id);
const deVisita = (tramo.deVisita ?? []).map((v) => bestiaDe.get(v)!);
const lista: Bestia[] = [...deLaRegion, ...deVisita];
const dePaso = new Set(tramo.deVisita ?? []);
const enEstaPagina = new Set(lista.map((b) => b.id));

/**
 * Las capas impresas que se corren aparte del piso. Cada una ocupa del alto de la escena lo que
 * ocupa su caja: lo de adelante de un entorno, por ejemplo, empieza a la altura del canto.
 */
const capa = (nombre: string | null) => (nombre ? PIEZAS_CAMINO.find((p) => p.nombre === nombre)! : null);
const lejos = capa(tramo.piezas.lejos);
const frente = capa(tramo.piezas.frente);
const enLaAltura = (caja: readonly number[]): string => `top: ${((caja[1]! / ALTO) * 100).toFixed(3)}%; height: ${((caja[3]! / ALTO) * 100).toFixed(3)}%`;

/** El piso, que es la capa de los bichos (`escenas-camino.ts`). */
const pisoSvg = pisoDelCamino(tramo, nombres);

/**
 * El cruce: un cartel por cada región vecina, con la flecha para el lado donde queda en el plano
 * redondo. Las que todavía no se caminan llevan a su recinto, y el cartel lo dice.
 */
const aqui = lugarDelRotulo(region);
const carteles = region.vecinas.map((v) => {
  const r = regionDe.get(v)!;
  const alla = lugarDelRotulo(r);
  return {
    id: v,
    href: hrefDeRegion(v),
    nombre: r.corto,
    canta: r.canta,
    tinta: tintaDe(r.disco),
    rumbo: Math.round((Math.atan2(alla.y - aqui.y, alla.x - aqui.x) * 180) / Math.PI),
    seCamina: CON_CAMINO.includes(v),
  };
});

/** Lo que suena de lejos (`D-76`): el disco de la región, o el de más bichos del camino. */
const fondo = fondoDe(
  region.disco,
  lista.flatMap((b) => (b.tema ? [b.tema] : [])),
  cancionero.temas,
  conAudio,
);

/** Lo que la isla necesita y no puede leer del HTML. */
const paraLaIsla = {
  region: id,
  forma: tramo.forma,
  ancho: tramo.ancho,
  escena: tramo.escena,
  foco: tramo.foco,
  lejos: fondo ? fondo.temas.map(urlDeFragmento) : [],
  total: datos.bestias.length,
  lobo: tramo.lobo?.x ?? null,
  claro: tramo.claro?.dx ?? null,
  bestias: lista.map((b) => ({ id: b.id, nombre: b.nombre, dice: loQueDice(b, BESTIARIO.sinTema) })),
};

/** Un vecino de "Anda cerca": acá, si anda por esta página; si no, en el camino donde vive. */
const hrefCerca = (c: string): string => (enEstaPagina.has(c) ? `#b-${c}` : `/redondopedia/bestiario/${bestiaDe.get(c)?.region}/#${c}`);

const titulo = `${region.nombre} — ${BESTIARIO.enLaPortada.titulo} — Fichín Ricotero`;
---

<Base
  titulo={titulo}
  descripcion={`${region.nombre}: ${region.canta}`}
  volverA={{ href: '/redondopedia/bestiario/', texto: CAMINO.volver }}
  discoDelPie="lobo-suelto"
>
  <section
    class="camino"
    id="camino"
    aria-label={CAMINO.escena}
    data-forma={tramo.forma}
    style={`--ancho: ${tramo.ancho}; --alto: ${ALTO}; --tr: ${tinta}`}
  >
    {/* El tablero: arriba de la escena, en el flujo; con la isla andando, flota encima (`D-76`). */}
    <div class="camino-tablero">
      <header class="recinto-cartel camino-cartel">
        <p class="recinto-numero">{CAMINO.sello}</p>
        <h1 class="recinto-nombre">{region.nombre}</h1>
        <p class="bestiario-canta">{region.canta}</p>
      </header>
      <p class="camino-bajada">{CAMINO.bajada}</p>
      <p class="bestiario-libreta" id="libreta" aria-live="polite">{BESTIARIO.libretaVacia(datos.bestias.length)}</p>
      {/* Los botones solo sirven con la isla: sin ella, la lista está abajo y nada suena. */}
      <div class="camino-botones">
        <button type="button" class="camino-boton" id="abrir-lista" aria-controls="aca-lista" aria-expanded="false" hidden>
          {CAMINO.lista}
        </button>
        {
          fondo && (
            <button type="button" class="camino-boton" id="lejos" aria-pressed="false" hidden>
              {CAMINO.lejos.prender}
            </button>
          )
        }
      </div>
      {fondo && <p class="camino-suena" id="suena" hidden>{CAMINO.lejos.suena(tituloDelDisco(fondo.disco))}</p>}
    </div>
    <a class="camino-saltar" href="#cruce">{CAMINO.saltar}</a>
    <div class="camino-escenario" id="escenario">
      <div class="camino-tira" id="tira">
        {/* La vista: con las capas corriéndose, queda quieta en la pantalla mientras la tira pasa. */}
        <div class="camino-vista" id="vista">
          {
            lejos && (
              <img
                class="capa capa--lejos"
                data-f={tramo.velocidad.lejos}
                src={rutaDePieza(lejos.nombre)}
                width={lejos.caja[2]}
                height={lejos.caja[3]}
                style={enLaAltura(lejos.caja)}
                alt=""
                fetchpriority="high"
              />
            )
          }
          <svg
            class="capa capa--piso bestiario-svg"
            data-f="1"
            viewBox={`0 0 ${tramo.ancho} ${ALTO}`}
            style={`aspect-ratio: ${tramo.ancho} / ${ALTO}`}
            set:html={pisoSvg}
          />
          {
            frente && (
              <img
                class="capa capa--frente"
                data-f={tramo.velocidad.frente}
                src={rutaDePieza(frente.nombre)}
                width={frente.caja[2]}
                height={frente.caja[3]}
                style={enLaAltura(frente.caja)}
                alt=""
                decoding="async"
              />
            )
          }

          <nav class="cruce" id="cruce" aria-labelledby="cruce-titulo" style={`--cruce: ${tramo.ancho - tramo.escena}`}>
            <p class="cruce-titulo" id="cruce-titulo">{CAMINO.cruce.titulo}</p>
            <ul class="cruce-carteles">
              {
                carteles.map((c, n) => (
                  <li>
                    <a
                      class:list={['cartel-cruce', { 'cartel-cruce--plano': !c.seCamina }]}
                      href={c.href}
                      data-region={c.id}
                      style={`--tr: ${c.tinta}; --rumbo: ${c.rumbo}deg; --giro: ${n % 2 ? 1.4 : -1.6}deg`}
                    >
                      <svg class="cartel-flecha" viewBox="-14 -10 28 20" aria-hidden="true">
                        <path d="M-11 0 L8 0 M1 -7 L9 0 L1 7" />
                      </svg>
                      <span class="cartel-nombre">{c.nombre}</span>
                      <span class="cartel-canta">{c.canta}</span>
                      {!c.seCamina && <span class="cartel-plano">{CAMINO.cruce.enElPlano}</span>}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </div>
    </div>
    <p class="recinto-deslizar camino-deslizar">{CAMINO.deslizar}</p>
  </section>

  <div class="bocadillo" id="bocadillo" hidden role="status">
    <p class="bocadillo-verso" id="bocadillo-verso"></p>
    <button type="button" class="bocadillo-ficha" id="bocadillo-ficha">{BESTIARIO.abrirFicha}</button>
  </div>

  <div class="bestiario-hoja" id="hoja" hidden role="dialog" aria-modal="false" aria-labelledby="hoja-titulo">
    <button type="button" class="bestiario-cerrar" id="cerrar" aria-label={BESTIARIO.cerrar}>✕</button>
    <div id="hoja-cuerpo"></div>
  </div>

  {/* Las figuras del plano, para las fichas de los que no tienen recorte de tapa. */}
  <svg class="bestiario-svg camino-simbolos" aria-hidden="true" focusable="false">
    <defs set:html={simbolos(lista)} />
  </svg>

  <section class="bestiario-indice camino-fichas" id="aca-lista" aria-labelledby="aca" style={`--tr: ${tinta}`}>
    <button type="button" class="bestiario-cerrar camino-cerrar-lista" id="cerrar-lista" aria-label={CAMINO.cerrarLista} hidden>✕</button>
    <h2 class="lado" id="aca">{CAMINO.aca}</h2>
    <ul class="bestiario-lista">
      {
        lista.map((b) => (
          <FichaBestia
            bestia={b}
            tinta={tintaDe(regionDe.get(b.region)!.disco)}
            nombres={nombres}
            hrefCerca={hrefCerca}
            dePaso={dePaso.has(b.id)}
          />
        ))
      }
    </ul>
    <a class="recinto-volver" href="/redondopedia/bestiario/#plano">{BESTIARIO.volverAlPlano}</a>
  </section>

  <script type="application/json" id="datos-camino" set:html={JSON.stringify(paraLaIsla)} />
  <script>
    import '../../../scripts/camino.ts';
  </script>
</Base>
