---
/**
 * La plantilla de articulo de la Redondopedia (`US-05`, `BR-07`, `BR-08`).
 *
 * El rotulado por afirmacion de `BR-08` se pinta aca: cada segmento del cuerpo llega
 * con su rotulo y la marca vive EN el parrafo — la leyenda se corre con borde tiza y
 * rombo, el testimonio con celeste y comillas (los mismos codigos del quiz, que la
 * regla de marca prohibe disfrazar de disco), y el hecho lleva su ficha RES al final
 * del segmento. Nada se comunica solo con color.
 *
 * La tapa entera entra en los articulos de tipo `disco` (`BR-07` la pide como campo;
 * `D-04`: baja resolucion y credito a Rocambole). Los demas tipos llevan un **detalle
 * recortado** junto al titulo, que `D-21` habilito y `UX-05` (7b/7c) reparte: historia
 * viste Gulp!, mitologia viste Lobo suelto. Tres articulos quedan sin detalle por tono
 * — la lista vive en `arte.ts`.
 */
import Base from '../../layouts/Base.astro';
import { REDONDOPEDIA, PIE_DE_TAPA } from '../../lib/sitio/copy.ts';
import type { Disco } from '../../lib/letra/discos.ts';
import {
  TIPO_A_CATEGORIA,
  segmentar,
  type Articulo,
  type Segmento,
} from '../../lib/redondopedia.ts';
import {
  recorte,
  tapa,
  STICKER_DISCO,
  DISCO_DE_CATEGORIA,
  detalleArticulo,
  discosDe,
  SIN_DETALLE_POR_TONO,
} from '../../lib/sitio/arte.ts';
import crudo from '../../data/redondopedia.json';
import cancionero from '../../data/cancionero.json';
import { partesParaCorregir } from '../../lib/correccion/redondopedia.ts';
import { cargar as cargarCancionero, slugDeLetra, type Cancionero } from '../../lib/cancionero/banco.ts';

export function getStaticPaths() {
  const todos = (crudo as unknown as { articulos: Articulo[] }).articulos;
  return todos.map((articulo) => ({
    params: { slug: articulo.slug },
    props: { articulo },
  }));
}

interface Props {
  articulo: Articulo;
}

const { articulo } = Astro.props as Props;
const todos = (crudo as unknown as { articulos: Articulo[] }).articulos;
const titulos = new Map(todos.map((a) => [a.slug, a.titulo]));

/**
 * Si el articulo es de un tema y tenemos su letra, se enlaza.
 *
 * Es el puente que faltaba entre las dos mitades del sitio: el articulo cuenta de que
 * habla la cancion, el cancionero la trae entera con los acordes. Cruzar por titulo
 * normalizado y no por slug — la Redondopedia escribe `ji-ji-ji` y el cancionero
 * `jijiji`, del mismo tema.
 */
const letra =
  articulo.tipo === 'tema'
    ? slugDeLetra(articulo.titulo, cargarCancionero(cancionero as unknown as Cancionero))
    : null;

const categoria = TIPO_A_CATEGORIA[articulo.tipo];
const laTapa = articulo.tipo === 'disco' ? tapa(articulo.slug) : null;
const archivoSticker = STICKER_DISCO[articulo.slug];
const sticker = archivoSticker ? recorte(archivoSticker) : null;

/**
 * El detalle de tapa que acompaña al titulo cuando el articulo NO es de disco
 * (`UX-05`, 7b y 7c). Va junto al titulo y nunca detras del cuerpo rotulado: la prosa
 * larga con segmentos de `BR-08` es scroll, y un fondo detras de algo que se estira es
 * lo que `UX-04` evita.
 */
const detalle = detalleArticulo(articulo.tipo, articulo.slug, categoria);

/**
 * Que tapas se ven en esta ficha (`D-21`, condicion 1): la del propio disco si el
 * articulo es de disco, o la del recorte que lo viste si no lo es.
 */
const nombreDetalle = detalle?.split('/').pop()?.replace(/\.jpg$/, '') ?? null;
const tapasUsadas = laTapa ? [articulo.titulo] : discosDe([nombreDetalle]);

/**
 * De que disco se viste el pie de imprenta de este articulo.
 *
 * Si el articulo ES un disco, el suyo: la ficha de *Luzbelito* termina en tinta de
 * Luzbelito y no en la de la categoria. Si no, el que `D-19` le da a su categoria.
 *
 * **Los tres de tono grave no llevan ninguno**, y no es una omision: `UX-20` §3.4 les
 * apaga la pantalla entera —sin velo, sin capa de fondo mas alla del grano—, y una
 * silueta de disco al pie de la muerte del Indio es exactamente el adorno que
 * `.claude/rules/voz-ricotera.md` §6 saca de esas tres pantallas. La franja se pinta
 * igual, con la costura en tinta apagada: termina la hoja sin decorar nada.
 */
const discoDelPie = SIN_DETALLE_POR_TONO.has(articulo.slug)
  ? undefined
  : articulo.tipo === 'disco'
    ? articulo.slug
    : DISCO_DE_CATEGORIA[categoria];

/** Lo que el botón de corrección deja elegir: el artículo, cada dato y cada párrafo (`CTR-10` §2.1). */
const partesCorregibles = partesParaCorregir(articulo);
const etiquetaRotulo = (seg: Segmento): string =>
  seg.rotulo === 'leyenda' ? 'Leyenda' : `Lo contó ${seg.quien ?? 'alguien'}`;
---

<Base
  titulo={`${articulo.titulo} — La Redondopedia`}
  descripcion={articulo.resumen}
  volverA={{ href: '/redondopedia/', texto: REDONDOPEDIA.volverPortada }}
  tapas={tapasUsadas}
  discoDelPie={discoDelPie}
>
  {/*
    `articulo--grave` marca los tres artículos de tono grave — Bulacio, Olavarría y la
    muerte del Indio — para que la hoja de estilos sepa que ahí no va ningún adorno. Hoy
    lo único que se apaga con esa clase es la capitular de la bajada (`T-187`), y la lista
    es la misma que ya usa `detalleArticulo()` para no ponerles el recorte de tapa: si
    algún día se corrige quiénes son, se corrige en un solo lugar.

    `UX-20` §3.4 lo pide para la pantalla entera, no solo para el párrafo rotulado. Una
    letra capitular de tres renglones arriba de un artículo sobre un pibe que la policía
    mató es exactamente la clase de decoración que ese apartado prohíbe.
  */}
  <article
    class:list={[
      'articulo',
      `articulo--${categoria}`,
      { 'articulo--grave': SIN_DETALLE_POR_TONO.has(articulo.slug) },
    ]}
  >
    <span class="articulo-tipo">{articulo.tipo}</span>
    {detalle && <img class="detalle-articulo" src={detalle} alt="" aria-hidden="true" loading="lazy" />}
    <h1>{articulo.titulo}</h1>

    {
      laTapa && (
        /* La ficha estampada y quieta (`UX-22` §9): el papel y el sello son el MARCO, sin
           sombra (`D-64`); la foto de adentro es el mismo JPEG a color de siempre.
           Y no se anima nada — `UX-20` §2: un articulo no se mueve. */
        <figure class="figura-tapa">
          <span class="papel-ficha">
            <img
              class="tapa-disco"
              src={laTapa}
              alt={`Tapa de ${articulo.titulo}`}
              loading="lazy"
            />
          </span>
          <figcaption class="credito-tapa sello-credito">
            {PIE_DE_TAPA[articulo.slug as Disco]}
          </figcaption>
        </figure>

      )
    }

    <p class="articulo-resumen">{articulo.resumen}</p>

    {
      letra && (
        <p class="ir-a-la-letra">
          <a href={`/letras-y-acordes/${letra}/`}>Leé la letra entera, con los acordes →</a>
        </p>
      )
    }

    {
      articulo.datos.length > 0 && (
        <aside class="ficha">
          {sticker && (
            <img class="sticker-ficha" src={sticker} alt="" aria-hidden="true" />
          )}
          <dl>
            {articulo.datos.map((d) => (
              <>
                <dt>{d.etiqueta}</dt>
                <dd>
                  {d.valor}{' '}
                  <span class="fuente-chip">
                    {d.rotulo}
                    {d.fuente ? ` · ${d.fuente}` : ''}
                  </span>
                </dd>
              </>
            ))}
          </dl>
        </aside>
      )
    }

    {
      articulo.cuerpo.map((seg) => (
        <p class={`parrafo parrafo--${seg.rotulo}`}>
          {seg.rotulo !== 'hecho' && (
            <span class="marca-rotulo">{etiquetaRotulo(seg)}</span>
          )}
          {segmentar(seg.texto).map((pieza) =>
            pieza.clase === 'enlace' ? (
              <a href={`/redondopedia/${pieza.slug}/`}>{pieza.texto}</a>
            ) : (
              pieza.texto
            ),
          )}
          {seg.rotulo === 'hecho' && seg.fuente && (
            <span class="fuente-chip"> — hecho · {seg.fuente}</span>
          )}
          {seg.rotulo !== 'hecho' && seg.fuente && (
            <span class="fuente-chip"> — {seg.fuente}</span>
          )}
        </p>
      ))
    }

    {
      articulo.veaTambien.length > 0 && (
        <nav aria-label={REDONDOPEDIA.veaTambien}>
          <h2 class="lado">{REDONDOPEDIA.veaTambien}</h2>
          <ul class="vea-tambien">
            {articulo.veaTambien.map((slug) => (
              <li>
                <a href={`/redondopedia/${slug}/`}>{titulos.get(slug) ?? slug}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {/*
      El botón de corrección (`BR-21`, `UX-09`), al pie del artículo y después del "vea
      también": es lo último que se lee, como una nota. `PRD-correcciones.md` §4 puso a la
      Redondopedia primera en la fila de los que faltaban, por valor —prosa larga, tres
      rótulos por párrafo—, y llegó el 2026-10-01 junto con la casilla (`D-51`).

      Se arma en el navegador porque el componente es una isla; acá queda el ancla y, al lado,
      las partes del artículo ya armadas en build (`partesParaCorregir`): el panel deja
      elegir el párrafo o el dato, y la corrección lleva su texto, su rótulo y su ubicación,
      como pide `CTR-10` §2.1 (`FIND-87` de `REV-17`).
    */}
    <div id="correccion-articulo"></div>
    <script type="application/json" id="correccion-partes" set:html={JSON.stringify(partesCorregibles)} />
  </article>

  <a class="accion-abajo" href="/redondopedia/">← {REDONDOPEDIA.volverPortada}</a>

  <script>
    import { botonCorreccion } from '../../scripts/correccion.ts';

    import type { ParteCorregible } from '../../lib/correccion/redondopedia.ts';

    const ancla = document.getElementById('correccion-articulo');
    let partes: ParteCorregible[] = [];
    try {
      partes = JSON.parse(document.getElementById('correccion-partes')?.textContent ?? '[]');
    } catch {
      partes = [];
    }
    // La primera parte es el artículo entero: es lo que se manda si nadie elige otra.
    const primera = partes[0];
    if (ancla && primera) ancla.replaceWith(botonCorreccion(() => primera.datos, partes));
  </script>
</Base>
