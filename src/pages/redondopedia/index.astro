---
/**
 * La portada de la Redondopedia (`US-05`).
 *
 * Es el origen del grafo de `BR-09`: desde aca se llega a TODOS los articulos
 * publicados siguiendo enlaces — el indice lista cada uno, y el test del grafo
 * (`redondopedia.test.ts`) verifica que ademas el tejido interno no deje huerfanos.
 *
 * La explicacion del rotulado va arriba porque es la promesa central de `D-14`:
 * el lector sabe desde la puerta que casilla es cada cosa.
 */
import Base from '../../layouts/Base.astro';
import { PORTAL, LUGARES, REDONDOPEDIA } from '../../lib/sitio/copy.ts';
import { EN_VIVO } from '../../lib/recital/copy.ts';
import { porTipo, TIPO_A_CATEGORIA, type Articulo } from '../../lib/redondopedia.ts';
import { fondoTapa, discosDe } from '../../lib/sitio/arte.ts';
import crudo from '../../data/redondopedia.json';

/** La cabecera viste Gulp! (`D-19`, catalogo `UX-05`), con velo (`D-21`). */
const fondoCabecera = fondoTapa('gulp-pincelada');
const tapasUsadas = fondoCabecera ? discosDe(['gulp-pincelada']) : [];

const articulos = (crudo as unknown as { articulos: Articulo[] }).articulos;
const grupos = porTipo(articulos);

const recortar = (texto: string): string =>
  texto.length > 150 ? `${texto.slice(0, 147).trimEnd()}…` : texto;
---

{/*
  **Sin `conBanderas`, y no es una poda de adorno.** Esa prop hace que `Base.astro` pinte
  la franja fija de *Oktubre*, y esta pantalla ya pintaba su propio fondo de *Gulp!* en la
  cabecera: eran DOS `.tapa-fondo` en el mismo documento, y las dos declaran
  `view-transition-name: lugar`. Dos elementos con el mismo nombre de tránsito **cancelan
  el tránsito entero, y no avisan** — o sea que el paso de `ADR-03` estaba apagado en
  silencio justo en la ruta que más se cruza con el portal. Verificado en el navegador el
  2026-09-02: `querySelectorAll('.tapa-fondo')` devolvía dos.

  De paso arregla el crédito: el pie decía "arte de la tapa de Gulp!" mientras la multitud
  de *Oktubre* estaba ahí abajo, a la vista. La franja de Oktubre es identidad del portal;
  acá la sección viste Gulp!, que es lo que `D-19` le da. Y el pie de imprenta le pone el
  piso que la franja le daba.
*/}
<Base
  titulo="La Redondopedia — Fichín Ricotero"
  descripcion={REDONDOPEDIA.bajada}
  volverA={{ href: '/', texto: PORTAL.volverAlArcade }}
  tapas={tapasUsadas}
  discoDelPie="gulp"
>
  <div class="portada-redondopedia">
    {fondoCabecera && <div class="tapa-fondo tapa-fondo--gulp-pincelada" aria-hidden="true" />}
    <h1 class="titulo-seccion">{REDONDOPEDIA.titulo}</h1>
    <p class="donde-estas">{LUGARES.redondopedia}</p>
    <p class="bajada-portal">{REDONDOPEDIA.bajada}</p>

    <p class="leyenda-rotulos">
    {REDONDOPEDIA.explicacionRotulos}<b class="es-leyenda"
      >◆ {REDONDOPEDIA.palabraLeyenda}</b
    >{REDONDOPEDIA.explicacionMedio}<b class="es-testimonio"
      >❝ {REDONDOPEDIA.palabraTestimonio}</b
    >{REDONDOPEDIA.explicacionCierre}
    </p>

    {/* `D-72`: los recitales en pantalla (`IDEA-15`). No es un artículo —no tiene casilla de
        hecho, leyenda ni testimonio: cada lista lleva el rótulo de su fuente—, así que no
        entra al índice por tipo: va acá arriba, como una puerta aparte. */}
    <a class="tarjeta-articulo tarjeta-articulo--historia en-vivo-puerta" href="/redondopedia/en-vivo/">
      <strong>{EN_VIVO.enLaPortada.titulo}</strong>
      <span>{EN_VIVO.enLaPortada.resumen}</span>
    </a>
  </div>

  {/* El rodillo separa una categoria de la siguiente (`UX-22` §9). Se filtran los grupos
      vacios ANTES de numerar para que el primero que se ve nunca arranque con separador. */}
  {
    [...grupos.entries()].filter(([, lista]) => lista.length > 0).map(
      ([tipo, lista], i) => (
        <>
          {i > 0 && <hr class="rodillo" aria-hidden="true" />}
          <section>

            <h2 class="lado">{REDONDOPEDIA.secciones[tipo]}</h2>
            <ul class="indice-articulos">
              {lista.map((a) => (
                <li>
                  <a
                    class={`tarjeta-articulo tarjeta-articulo--${TIPO_A_CATEGORIA[a.tipo]}`}
                    href={`/redondopedia/${a.slug}/`}
                  >
                    <strong>{a.titulo}</strong>
                    <span>{recortar(a.resumen)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        </>
      ),
    )
  }

</Base>
