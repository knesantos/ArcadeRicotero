---
/**
 * El portal del arcade: la pantalla de entrada de todo el sitio.
 *
 * Un cassette grabado en casa: lado A los juegos, lado B la lectura. Cada casete
 * viste la paleta real de su disco (mezcla `D-19`) y el collage de fondo trae los
 * recortes que pide `UX-04` con tecnicas fichadas de Rocambole (`RES-06`): la
 * mosca volando, la gente con banderas, el perro suelto.
 *
 * Molinetes abiertos (`D-14`): esta pantalla no pide nada — ni cuenta ni saber.
 */
import Base from '../layouts/Base.astro';
import { PORTAL, JUEGOS, CASETE_REDONDOPEDIA, type Casete } from '../lib/sitio/copy.ts';
import { conRecorteReal } from '../lib/sitio/arte.ts';

const lados: Array<{ titulo: string; casetes: readonly Casete[] }> = [
  { titulo: PORTAL.ladoA, casetes: JUEGOS },
  { titulo: PORTAL.ladoB, casetes: [CASETE_REDONDOPEDIA] },
];
---

<Base titulo="Arcade Ricotero" descripcion={PORTAL.bajada} conBanderas conMosca>
  <script is:inline slot="cabeza">
    // El quiz vivia en la raiz: los links de desafio viejos (`?g=quiz&p=...`) siguen
    // valiendo — se redirigen a /quiz/ con la query intacta (ADR-02 no cambia).
    if (/(^|[?&])g=/.test(location.search)) location.replace('/quiz/' + location.search);
  </script>

  <header class="portada-arcade">
    <img class="recorte-portada" src={conRecorteReal('/arte/perro.svg')} alt="" aria-hidden="true" />
    <h1 class="marca-grande">ARCADE RICOTERO</h1>
    <p class="bajada-portal">{PORTAL.bajada}</p>
  </header>

  {
    lados.map((lado) => (
      <section>
        <h2 class="lado">{lado.titulo}</h2>
        <ul class="casetera">
          {lado.casetes.map((c) => (
            <li>
              <a
                class:list={['casete', `casete--${c.variante}`, { 'casete--pronto': !c.accion }]}
                href={c.href}
              >
                <img class="casete-arte" src={conRecorteReal(c.arte)} alt="" aria-hidden="true" />
                <span class="casete-etiqueta">
                  <strong class="casete-titulo">{c.titulo}</strong>
                  <span class="casete-baja">{c.baja}</span>
                </span>
                <span class="casete-pie">
                  <span class="casete-disco">{c.viste}</span>
                  {c.accion ? (
                    <span class="casete-accion">{c.accion}</span>
                  ) : (
                    <span class="casete-pronto">{PORTAL.enLaCocina}</span>
                  )}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
