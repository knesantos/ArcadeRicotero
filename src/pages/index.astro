---
/**
 * El portal del arcade: la pantalla de entrada de todo el sitio.
 *
 * Un cassette grabado en casa: lado A los juegos, lado B la lectura. Cada casete
 * viste la paleta real de su disco (mezcla `D-19`) y el collage de fondo trae los
 * recortes que pide `UX-04` con tecnicas fichadas de Rocambole (`RES-06`): la
 * mosca volando, la gente con banderas, y ahora la figura de la cadena.
 *
 * Molinetes abiertos (`D-14`): esta pantalla no pide nada — ni cuenta ni saber.
 */
import Base from '../layouts/Base.astro';
import { PORTAL, LUGARES, JUEGOS, CASETE_REDONDOPEDIA, CASETE_CANCIONERO, OKTUBRE, type Casete } from '../lib/sitio/copy.ts';
import { arteDeCasete, conRecorteReal, discoDeRecorte, discosDe, materialDeCasete, medidas, recorte } from '../lib/sitio/arte.ts';
import { segunLaPartida } from '../lib/sitio/portal.ts';
import { cumpleDelDia, discosDeOktubre, type FichaCruda } from '../lib/sitio/oktubre.ts';
import { pistaDe, primeraOracion, restoDeLaBajada } from '../lib/sitio/caratula.ts';
import { cargarBanco, type BancoCrudo } from '../lib/letra/banco.ts';
import crudoLetra from '../data/letra.json';
import redondopedia from '../data/redondopedia.json';

/**
 * El afiche de octubre (`D-49`): los discos que salieron en octubre, sacados de las fichas.
 *
 * Se imprime siempre y se muestra solo en octubre: lo decide la cabeza de esta página con
 * la fecha del teléfono, antes del primer cuadro (más abajo). Así el sitio no depende de
 * que alguien lo reconstruya el 1.º de octubre ni el 1.º de noviembre.
 *
 * La estampa sale impresa con la fecha del build y la isla `oktubre.ts` la corrige con la de
 * quien mira. Si *Oktubre* no estuviera entre los de octubre —una ficha corregida—, el
 * afiche no se imprime: no hay cumpleaños que festejar en el mes equivocado.
 */
const { deOktubre, total: discosEnTotal } = discosDeOktubre(
  (redondopedia as unknown as { articulos: FichaCruda[] }).articulos,
);
const salidaOktubre = deOktubre.find((d) => d.slug === 'oktubre');
const estampaDelBuild = salidaOktubre ? cumpleDelDia(new Date(), salidaOktubre) : '';
/** El título corto de cada fecha: en un casillero de cien píxeles no entra "¡Bang! ¡Bang!… Estás liquidado". */
const CORTO: Record<string, string> = { 'bang-bang-estas-liquidado': '¡Bang! ¡Bang!' };

/**
 * Los juegos cuya partida depende de un banco que puede estar vacío. El portal pregunta lo
 * mismo que la página del juego, con la misma función, así las dos pantallas no pueden
 * contar cosas distintas (`portal.ts`). Los demás juegos siempre tienen partida.
 */
const HAY_PARTIDA: Record<string, boolean> = {
  '/juegos/completar-la-letra/': cargarBanco(crudoLetra as unknown as BancoCrudo).length > 0,
};

// Los discos que se ven acá: el de cada casete mas la franja de Oktubre del fondo.
// El pie los nombra (`D-21`, condicion 1).
/*
 * Desde `UX-25` §2.2 los casetes ya no llevan la tapa chica, así que de tapas enteras **acá
 * queda un disco solo**: la franja de Oktubre del fondo. Acreditar ocho tapas que ya no se
 * ven sería el defecto contrario al de `D-21` condición 1. Lo que sí se suma, más abajo,
 * son los discos de los recortes que visten los casetes (`tapasUsadas`).
 */
const tapasFondo = discosDe(['oktubre-banderas']);

/**
 * El personaje de portada.
 *
 * Era el perro. Pasa a ser la figura encadenada, calcada en linea blanca — la pidio el
 * usuario el 2026-08-24. Si el archivo no estuviera, cae al perro dibujado: el mismo
 * criterio de reemplazo que el resto del collage.
 *
 * **Lo que esta pagina no dice sobre ella, y es a proposito:** de que disco sale. `INV-02`
 * reporto que la figura encadenada **no estaba en el arte del vinilo de Oktubre del 86** y
 * que se difundio con la reedicion en CD, y eso sigue en "reportado, no verificado".
 * Mientras siga ahi, el recorte se muestra pero **no se le atribuye disco**: por eso no
 * entra en `tapasUsadas`, que es lo que arma el credito del pie (`D-21`), y por eso el
 * texto de la tarjeta acredita a Rocambole sin nombrar el album. Ficha pedida en
 * `Docs/SUGERENCIAS/HILO-para-investigador-figura-encadenada.md`.
 */
const artePortada = recorte('oktubre-cadena.png', conRecorteReal('/arte/perro.svg'))!;
const medidaPortada = medidas(artePortada);

/**
 * Cada casete con su arte ya resuelta y **medida**.
 *
 * Se resuelve acá y no en el template porque `medidas()` lee el archivo en disco: es
 * trabajo de build, y de paso deja el marcado sin logica adentro.
 */
const lados: Array<{ titulo: string; lado: 'a' | 'b'; casetes: readonly Casete[] }> = [
  { titulo: PORTAL.ladoA, lado: 'a', casetes: JUEGOS },
  { titulo: PORTAL.ladoB, lado: 'b', casetes: [CASETE_CANCIONERO, CASETE_REDONDOPEDIA] },
];

/**
 * La bajada, cortada en el punto que el texto ya tiene (`UX-25` §2.4).
 *
 * Medido a 375×812: los ocho casetes sumaban ~1757 px y el portal medía 2,95 pantallas. La
 * primera oración de cada bajada es la que canta —la que hace el trabajo de `CNT-02`— y el
 * resto es detalle que se lee entrando.
 *
 * **Se corta en el punto, no con `line-clamp`.** Un recorte por altura mete puntos
 * suspensivos, y el suspensivo en este sitio es del Indio y de la Redondopedia
 * (`voz-ricotera.md` §3.7), no de un casete. Cortar en la puntuación que el autor ya puso
 * deja una oración entera, no una frase mutilada.
 *
 * **El texto completo no se toca**: sigue entero en `copy.ts`, que es lo que audita
 * `voz.test.ts`. Lo que cambia es cuánto se imprime.
 *
 * **La función ya no vive acá**: `primeraOracion` está en `lib/sitio/caratula.ts` desde el
 * ciclo 17, porque la carátula de cada juego (`D-54`) corta la bajada con la misma regla y una
 * regla escrita dos veces se desincroniza. Allá también vive `restoDeLaBajada`, lo que el
 * escritorio suma, y `pistaDe`, el número de la tapita.
 */

/*
 * Cada casete lleva su numero de pista, como la lista escrita a mano en la tapita de un
 * cassette grabado en casa: A1, A2… del lado A, B1, B2 del lado B. Es la metafora que el
 * portal ya tenia —"Lado A · Para jugar"— llevada hasta la etiqueta, y es decoracion: el
 * lector de pantalla no la necesita para saber que hay en cada casete.
 */
const conArte = lados.map((lado, l) => ({
  titulo: lado.titulo,
  lado: lado.lado,
  casetes: lado.casetes.map((copia, i) => {
    const c = segunLaPartida(copia, HAY_PARTIDA[copia.href ?? ''] ?? true);
    // `D-49`: tapa entera, detalle o recorte — cada material se pega distinto (`sitio.css`).
    const arte = arteDeCasete(c.arte);
    const medidaArte = medidas(arte);
    return {
      ...c,
      arte,
      material: materialDeCasete(arte),
      medidaArte,
      // Un detalle mucho más ancho que alto (el "Gulp." del sobre, 213×111) recortado al
      // cuadrado pierde las puntas: se leía "ɡulh". Ese conserva su proporción (`sitio.css`).
      apaisada: medidaArte !== null && medidaArte.ancho / medidaArte.alto > 1.4,
      baja: primeraOracion(c.baja),
      // `UX-35` §2: en el escritorio sobra alto para la bajada entera. El resto se imprime
      // siempre y se muestra desde 80 rem; en el teléfono sigue la primera oración sola.
      resto: restoDeLaBajada(c.baja),
      pista: pistaDe(l === 0 ? 'A' : 'B', i),
    };
  }),
}));

/*
 * El credito del pie nombra tambien los discos de los recortes que visten los casetes
 * (`D-21`, condicion 1: la pantalla nombra lo que usa). El pie de imprenta ya lo hacia con
 * la figura que pisa su franja; los casetes pegaban el lobo y la mosca sin nombrarlos, y
 * desde este ciclo suman el medallon de Momo y el bondi. El mapa es uno solo
 * (`discoDeRecorte`): el casete dibujado no es de ningun disco y no acredita nada.
 */
const tapasUsadas = [
  ...new Set([
    ...tapasFondo,
    ...conArte.flatMap((lado) => lado.casetes.map((c) => discoDeRecorte(c.arte))).filter((d): d is string => d !== null),
  ]),
];
---

<Base titulo={PORTAL.nombre} descripcion={PORTAL.bajada} conBanderas conMosca tapas={tapasUsadas} discoDelPie="oktubre">
  <script is:inline slot="cabeza">
    // El quiz vivia en la raiz: los links de desafio viejos (`?g=quiz&p=...`) siguen
    // valiendo — se redirigen a /quiz/ con la query intacta (ADR-02 no cambia).
    if (/(^|[?&])g=/.test(location.search)) location.replace('/quiz/' + location.search);

    /**
     * El umbral corre UNA VEZ POR VISITA (`T-185`, `UX-20` §2, `ADR-03` §5).
     *
     * Volver a la portada despues de jugar tiene que sentirse como volver, no como
     * entrar de nuevo: si el umbral corriera en cada carga, el que va y viene entre dos
     * juegos lo veria seis veces por sesion, y ahi deja de ser una entrada y pasa a ser
     * un peaje. `ADR-03` §5 lo pone como condicion dura: el umbral y el transito no se
     * disparan en la misma navegacion.
     *
     * Va en linea y en la cabeza a proposito: tiene que decidir **antes del primer
     * cuadro**. Un atributo puesto despues de pintar seria un parpadeo.
     *
     * Si `sessionStorage` no esta —ventana privada, almacenamiento bloqueado— no hay
     * umbral y la portada aparece entera y quieta. Degradar sin umbral es correcto;
     * degradar corriendolo siempre seria justo el defecto que esto evita.
     */
    try {
      if (!sessionStorage.getItem('umbral')) {
        document.documentElement.dataset.umbral = '';
        sessionStorage.setItem('umbral', '1');
      }
    } catch (e) {
      /* sin almacenamiento no hay umbral, y no pasa nada */
    }

    /**
     * Octubre, el mes del disco (`D-49`). En octubre la portada lleva el afiche de *Oktubre*.
     *
     * Lo decide la fecha del teléfono y no la del build, y por el mismo motivo que el umbral
     * va acá arriba: un afiche que aparece después de pintar empuja la casetera entera hacia
     * abajo, y eso es un salto. Es la misma pregunta que `esOktubre()` de
     * `lib/sitio/oktubre.ts`, escrita en línea porque este bloque no puede importar nada.
     */
    if (new Date().getMonth() === 9) document.documentElement.dataset.mes = 'oktubre';
  </script>

  {/* El frente del portal (`UX-35` §2): la cabecera y el afiche. En el teléfono van uno
      debajo del otro, como siempre; desde 64 rem van lado a lado, y fuera de octubre la
      cabecera ocupa sola el renglón. Es un envoltorio y nada más: no cambia el orden de
      lectura ni lo que dice cada uno. */}
  <div class="portal-frente">
  <header class="portada-arcade">
    <img
      class="recorte-portada"
      src={artePortada}
      alt=""
      aria-hidden="true"
      decoding="async"
      width={medidaPortada?.ancho}
      height={medidaPortada?.alto}
    />
    <h1 class="marca-grande">FICHÍN RICOTERO</h1>
    <p class="donde-estas">{LUGARES.portal}</p>
    <p class="bajada-portal">{PORTAL.bajada}</p>
  </header>

  {/* El afiche de octubre (`D-49`). Está siempre en el documento y se ve solo con
      `data-mes="oktubre"`, que pone la cabeza de esta página antes del primer cuadro. El
      sello va en la letra calcada de la tapa; las fechas, una por disco, cada una con la
      tinta del suyo (`D-19`) y llevando a su ficha, que es donde está la fuente. */}
  {
    salidaOktubre && (
      <section class="oktubre" aria-labelledby="oktubre-sello">
        <div class="oktubre-cabeza">
          <h2 class="oktubre-sello" id="oktubre-sello">{OKTUBRE.sello}</h2>
          <span class="oktubre-cumple" data-cumple-dia={salidaOktubre.dia} data-cumple-anio={salidaOktubre.anio}>
            {estampaDelBuild}
          </span>
        </div>
        <p class="oktubre-canta">{OKTUBRE.canta}</p>
        <p class="oktubre-cuenta">{OKTUBRE.cuenta(deOktubre.length, discosEnTotal)}</p>
        <ul class="oktubre-calendario" aria-label={OKTUBRE.calendario}>
          {deOktubre.map((d) => (
            <li class:list={['oktubre-fecha', `oktubre-fecha--${d.slug}`]}>
              <a href={`/redondopedia/${d.slug}/`}>
                <span class="oktubre-dia">{d.dia}</span>
                <span class="oktubre-disco">{CORTO[d.slug] ?? d.titulo}</span>
                <span class="oktubre-anio">{d.anio}</span>
              </a>
            </li>
          ))}
        </ul>
        <a class="oktubre-jugar" href="/juegos/adivinar-el-tema/?disco=oktubre">{OKTUBRE.jugar}</a>
      </section>
    )
  }
  </div>

  {/* El rodillo separa la franja de marca de la casetera (`UX-22` §9): la veta que deja
      un rodillo entintado, no una linea. Es decoracion sin contenido, y por eso se
      esconde del lector de pantalla. */}
  <hr class="rodillo" aria-hidden="true" />

  {
    conArte.map((lado) => (
      <section>
        <h2 class="lado">{lado.titulo}</h2>
        <ul class:list={['casetera', `casetera--${lado.lado}`]}>
          {lado.casetes.map((c) => (
            <li>
              <a
                class:list={['casete', `casete--${c.variante}`, { 'casete--pronto': !c.accion }]}
                href={c.href}
              >
                <img
                  class:list={['casete-arte', `casete-arte--${c.material}`, { 'casete-arte--apaisada': c.apaisada }]}
                  src={c.arte}
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                  decoding="async"
                  width={c.medidaArte?.ancho}
                  height={c.medidaArte?.alto}
                />
                {/*
                    **La tapa chica salió del casete, y el sello bajó adentro de la
                    etiqueta** (`UX-25` §2.2 y §2.3).

                    La tapa eran 34×34 px de foto real. El sello tenía **una fila entera del
                    grid para él solo** (`grid-column: 1 / -1`), que existía para enfrentarlo
                    con la tapa; sin la tapa esa fila ya no enfrenta nada y eran ~40 px por
                    casete, ocho veces.

                    Por eso `.casete-pie` va ahora **adentro** de `.casete-etiqueta`: fuera de
                    ella, con la fila completa sacada, el grid lo mandaría a la columna del
                    dibujo. No es un detalle de anidado, es lo que lo deja donde `UX-25` lo
                    puso — debajo de la bajada, en la misma columna, a la izquierda.

                    Consecuencia que hay que saber: `tapasUsadas` de esta pantalla dejó de
                    acreditar las ocho tapas chicas. Acredita lo que realmente se ve —la franja
                    de Oktubre y los recortes de los casetes—, que es exactamente lo que pide
                    `D-21` condición 1.
                */}
                <span class="casete-etiqueta">
                  <strong class="casete-titulo">{c.titulo}</strong>
                  <span class="casete-baja">
                    {c.baja}
                    {c.resto && <span class="casete-baja-resto"> {c.resto}</span>}
                  </span>
                  <span class="casete-pie">
                    {c.accion ? (
                      <span class="casete-accion">{c.accion}</span>
                    ) : (
                      <span class="casete-pronto">{PORTAL.enLaCocina}</span>
                    )}
                    <span class="casete-pista" aria-hidden="true">{c.pista}</span>
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <script>
    // La estampa del cumpleaños, con la fecha de quien mira. Sin afiche no hace nada.
    import '../scripts/oktubre.ts';
  </script>
</Base>
