---
/**
 * El cascaron comun del sitio: grano de serigrafia, recortes de fondo y regreso.
 *
 * El quiz NO usa este layout: su pantalla es la isla de `partida.ts` y se maneja sola
 * (ver `pages/quiz.astro`). Esto es para el portal, las pantallas en la cocina y la
 * Redondopedia — todo lo que es lectura y navegacion, no partida.
 *
 * Molinetes abiertos (`D-14`): ninguna pagina que pase por aca pide nada.
 */
import '../styles/tokens.css';
import '../styles/sitio.css';
import Cabeza from '../components/Cabeza.astro';
import PieImprenta from '../components/PieImprenta.astro';
import { conRecorteReal, fondoTapa, medidas } from '../lib/sitio/arte.ts';

interface Props {
  titulo: string;
  descripcion: string;
  /** Recortes de fondo del collage: se apagan en pantallas de lectura larga. */
  conBanderas?: boolean;
  conMosca?: boolean;
  /** Adonde vuelve la cinta de regreso. Sin esto no hay cabecera (portal). */
  volverA?: { href: string; texto: string };
  /**
   * Los discos cuyas tapas se ven en esta pantalla (`D-21`, condicion 1).
   * La pagina los pasa y el pie los nombra: un fondo velado no tiene donde llevar su
   * propia firma, asi que el credito puntual se junta acá.
   */
  tapas?: readonly string[];
  /**
   * De que disco se viste el pie de imprenta (mezcla `D-19`). Sin esto la franja sale
   * desnuda —costura en tinta apagada y nada mas—, que es lo que corresponde en las
   * pantallas de tono grave y en las herramientas.
   */
  discoDelPie?: string;
}

const {
  titulo,
  descripcion,
  conBanderas = false,
  conMosca = false,
  volverA,
  tapas = [],
  discoDelPie,
} = Astro.props;

/**
 * La franja de multitud con banderas de *Oktubre*. Si el recorte real de la tapa ya
 * esta generado (`D-21`, `scripts/generar-tapas.mjs`), manda la foto; si no, queda el
 * dibujo — el mismo criterio de reemplazo que usa el resto del collage.
 *
 * Va anclada abajo y NUNCA detras de la marca grande: esa se escribe en `--marca-rojo`,
 * que sobre tapa velada no llega a AA. Lo verifica `contraste.test.ts`.
 */
const bandaOktubre = fondoTapa('oktubre-banderas');

// Las dos piezas del collage que este cascaron pega por su cuenta, con sus medidas
// leidas del archivo: un `<img>` sin medidas obliga al navegador a maquetar dos veces.
const arteBanderas = conRecorteReal('/arte/banderas.svg');
const arteMosca = conRecorteReal('/arte/mosca.svg');
const medidaBanderas = medidas(arteBanderas);
const medidaMosca = medidas(arteMosca);
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <title>{titulo}</title>
    <Cabeza titulo={titulo} descripcion={descripcion} />
    <slot name="cabeza" />
  </head>
  <body class="con-grano">
    {conBanderas && bandaOktubre && <div class="tapa-fondo tapa-fondo--portal" aria-hidden="true" />}
    {
      conBanderas && !bandaOktubre && (
        <img
          class="banderas-fondo"
          src={arteBanderas}
          alt=""
          aria-hidden="true"
          decoding="async"
          width={medidaBanderas?.ancho}
          height={medidaBanderas?.alto}
        />
      )
    }
    {
      conMosca && (
        <img
          class="mosca-viva"
          src={arteMosca}
          alt=""
          aria-hidden="true"
          decoding="async"
          width={medidaMosca?.ancho}
          height={medidaMosca?.alto}
        />
      )
    }
    <div class="contenido-sitio">
      {
        volverA && (
          <header class="cabecera-sitio">
            <a class="volver" href={volverA.href}>← {volverA.texto}</a>
            <a class="marca-chica" href="/" aria-label="Arcade Ricotero, a la portada">
              ARCADE RICOTERO
            </a>
          </header>
        )
      }
      <slot />
    </div>

    {/* El pie de imprenta es HERMANO de la hoja, no hijo: por eso llega a los dos bordes
        de la ventana sin `100vw`, sin margenes negativos y sin `overflow-x`. Y por eso el
        credito de `D-21` deja de ser un renglon al pie de la nada y queda impreso sobre la
        tinta del disco que acredita. */}
    <PieImprenta disco={discoDelPie} tapas={tapas} />

    <script>
      /**
       * El interruptor de la cinta (`UX-21`), para todo lo que pasa por este cascarón: el
       * portal, la Redondopedia y el cancionero. Las seis pantallas de juego no pasan por
       * acá y lo cargan cada una por su cuenta.
       *
       * Es la única isla del sitio que no es un juego, y la más chica: dibuja una estampa
       * y traduce un toque. **No se pinta sola en las tres pantallas de tono grave** —lo
       * decide ella misma, mirando la ruta contra `sitio/graves.ts`.
       */
      import '../scripts/cinta.ts';
    </script>
  </body>
</html>
