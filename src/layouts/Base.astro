---
/**
 * El cascaron comun del sitio: grano de serigrafia, recortes de fondo y regreso.
 *
 * El quiz NO usa este layout: su pantalla es la isla de `partida.ts` y se maneja sola
 * (ver `pages/quiz.astro`). Esto es para el portal, las pantallas en la cocina y la
 * Redondopedia — todo lo que es lectura y navegacion, no partida.
 *
 * Molinetes abiertos (`D-14`): ninguna pagina que pase por aca pide nada.
 */
import '../styles/tokens.css';
import '../styles/sitio.css';
import Cabeza from '../components/Cabeza.astro';
import PieImprenta from '../components/PieImprenta.astro';
import { conRecorteReal, medidas } from '../lib/sitio/arte.ts';

interface Props {
  titulo: string;
  descripcion: string;
  /**
   * La multitud de la tapa del disco del pie, mirando desde el final de la página (`D-62`).
   * Hasta el 2026-10-04 era una franja fija y velada al pie de la ventana; ahora el fondo
   * es negro liso y la gente es el piso del pie de imprenta. Hoy solo la tiene *Oktubre*.
   */
  conBanderas?: boolean;
  conMosca?: boolean;
  /** Adonde vuelve la cinta de regreso. Sin esto no hay cabecera (portal). */
  volverA?: { href: string; texto: string };
  /**
   * Los discos cuyas tapas se ven en esta pantalla (`D-21`, condicion 1).
   * La pagina los pasa y el pie los nombra: un fondo velado no tiene donde llevar su
   * propia firma, asi que el credito puntual se junta acá.
   */
  tapas?: readonly string[];
  /**
   * De que disco se viste el pie de imprenta (mezcla `D-19`). Sin esto la franja sale
   * desnuda —costura en tinta apagada y nada mas—, que es lo que corresponde en las
   * pantallas de tono grave y en las herramientas.
   */
  discoDelPie?: string;
}

const {
  titulo,
  descripcion,
  conBanderas = false,
  conMosca = false,
  volverA,
  tapas = [],
  discoDelPie,
} = Astro.props;

// La pieza del collage que este cascaron pega por su cuenta, con sus medidas leidas del
// archivo: un `<img>` sin medidas obliga al navegador a maquetar dos veces.
const arteMosca = conRecorteReal('/arte/mosca.svg');
const medidaMosca = medidas(arteMosca);
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <title>{titulo}</title>
    <Cabeza titulo={titulo} descripcion={descripcion} />
    <slot name="cabeza" />
  </head>
  <body class="con-grano">
    {
      conMosca && (
        <img
          class="mosca-viva"
          src={arteMosca}
          alt=""
          aria-hidden="true"
          decoding="async"
          width={medidaMosca?.ancho}
          height={medidaMosca?.alto}
        />
      )
    }
    {
      /* La mosca revolotea alrededor del mouse, o de donde tocó el dedo (`D-49`). Sin esta
         isla vuela el recorrido de CSS de siempre; va adentro del condicional para que una
         pantalla sin mosca no descargue el script. */
      conMosca && (
        <script>
          import '../scripts/mosca.ts';
        </script>
      )
    }
    <div class="contenido-sitio">
      {
        volverA && (
          <header class="cabecera-sitio">
            <a class="volver" href={volverA.href}>← {volverA.texto}</a>
            <a class="marca-chica" href="/" aria-label="Fichín Ricotero, a la portada">
              FICHÍN RICOTERO
            </a>
          </header>
        )
      }
      <slot />
    </div>

    {/* El pie de imprenta es HERMANO de la hoja, no hijo: por eso llega a los dos bordes
        de la ventana sin `100vw`, sin margenes negativos y sin `overflow-x`. Y por eso el
        credito de `D-21` deja de ser un renglon al pie de la nada y queda impreso sobre la
        tinta del disco que acredita. */}
    <PieImprenta disco={discoDelPie} tapas={tapas} multitud={conBanderas} />
  </body>
</html>
