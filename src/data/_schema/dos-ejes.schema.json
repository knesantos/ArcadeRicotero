{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ricotaarcade.local/schema/dos-ejes/2",
  "title": "CTR-08 v2 — Banco del test de dos ejes (D-57: una noche en cinco momentos)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contrato", "contratoVersion", "juego", "actualizado",
    "preguntasPorEje", "momentos", "cuadrantes", "items"
  ],
  "properties": {
    "contrato": { "const": "CTR-08" },
    "contratoVersion": { "const": 2 },
    "juego": { "const": "dos-ejes" },
    "actualizado": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "preguntasPorEje": {
      "comment": "BR-17 regla 3: impar, para que el empate sea imposible. Tiene que ser igual a momentos.length: eso lo vigila banco.test.ts, no este schema (CTR-08 v2.2).",
      "type": "integer",
      "minimum": 3,
      "maximum": 9,
      "not": { "multipleOf": 2 }
    },
    "momentos": {
      "comment": "D-57 punto 1: la noche, en orden. Cinco, uno por pregunta de cada eje. prefixItems fija el orden y con eso tambien que ningun id se repita.",
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        { "$ref": "#/$defs/momento", "properties": { "id": { "const": "previa" } } },
        { "$ref": "#/$defs/momento", "properties": { "id": { "const": "ida" } } },
        { "$ref": "#/$defs/momento", "properties": { "id": { "const": "vereda" } } },
        { "$ref": "#/$defs/momento", "properties": { "id": { "const": "adentro" } } },
        { "$ref": "#/$defs/momento", "properties": { "id": { "const": "vuelta" } } }
      ],
      "items": false
    },
    "cuadrantes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/cuadrante" }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "momento": {
      "comment": "nombre es el sello (registro 3); canta es la linea de registro 1. El texto es de contenido (CNT-30).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nombre", "canta"],
      "properties": {
        "id": { "enum": ["previa", "ida", "vereda", "adentro", "vuelta"] },
        "nombre": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24,
          "not": { "pattern": "[Bb]ulacio|[Oo]lavarr|[Cc]roma[ñn]" }
        },
        "canta": {
          "type": "string",
          "minLength": 6,
          "maxLength": 80,
          "not": { "pattern": "[Bb]ulacio|[Oo]lavarr|[Cc]roma[ñn]" }
        }
      }
    },
    "cuadrante": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "luzOscuridad", "ordenCaos", "nombre", "bajada", "estado"],
      "properties": {
        "id": { "type": "string", "pattern": "^CU-[1-4]$" },
        "luzOscuridad": { "enum": ["luz", "oscuridad"] },
        "ordenCaos": { "enum": ["orden", "caos"] },
        "nombre": {
          "comment": "Registro 1: 8 palabras como techo, y 26 caracteres porque tiene que leerse en la miniatura de la tarjeta (UX-06 §7). Sin comparativos (US-06, criterio 3).",
          "type": "string",
          "minLength": 3,
          "maxLength": 26,
          "pattern": "^\\S+( \\S+){0,7}$",
          "not": {
            "pattern": "\\b([Mm][áa]s|[Mm]enos|[Mm]ejor|[Pp]eor|[Nn]ivel|[Rr]anking|[Tt]op|[Vv]erdadero|[Ss]uperior|[Ii]nferior)\\b"
          }
        },
        "bajada": { "type": "string", "minLength": 10, "maxLength": 240 },
        "estado": { "enum": ["borrador", "listo"] }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "us", "eje", "enunciado", "opciones", "estado"],
      "properties": {
        "id": { "type": "string", "pattern": "^EJ-\\d{3}$" },
        "us": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^US-\\d{2}$" }
        },
        "eje": { "enum": ["luz-oscuridad", "orden-caos"] },
        "momento": { "enum": ["previa", "ida", "vereda", "adentro", "vuelta"] },
        "enunciado": {
          "type": "string",
          "minLength": 10,
          "maxLength": 120,
          "not": { "pattern": "[Bb]ulacio|[Oo]lavarr|[Cc]roma[ñn]" }
        },
        "opciones": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/opcion" }
        },
        "estado": { "enum": ["borrador", "listo", "retirado"] },
        "notaInterna": { "type": "string" }
      },
      "allOf": [
        {
          "comment": "BR-17 regla 1 y 2, eje luz-oscuridad.",
          "if": {
            "required": ["eje"],
            "properties": { "eje": { "const": "luz-oscuridad" } }
          },
          "then": {
            "properties": {
              "opciones": {
                "items": { "properties": { "polo": { "enum": ["luz", "oscuridad"] } } },
                "allOf": [
                  {
                    "contains": {
                      "required": ["polo"],
                      "properties": { "polo": { "const": "luz" } }
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "required": ["polo"],
                      "properties": { "polo": { "const": "oscuridad" } }
                    },
                    "minContains": 1,
                    "maxContains": 1
                  }
                ]
              }
            }
          }
        },
        {
          "comment": "BR-17 regla 1 y 2, eje orden-caos.",
          "if": {
            "required": ["eje"],
            "properties": { "eje": { "const": "orden-caos" } }
          },
          "then": {
            "properties": {
              "opciones": {
                "items": { "properties": { "polo": { "enum": ["orden", "caos"] } } },
                "allOf": [
                  {
                    "contains": {
                      "required": ["polo"],
                      "properties": { "polo": { "const": "orden" } }
                    },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": {
                      "required": ["polo"],
                      "properties": { "polo": { "const": "caos" } }
                    },
                    "minContains": 1,
                    "maxContains": 1
                  }
                ]
              }
            }
          }
        },
        {
          "comment": "D-57 punto 4 y CTR-08 v2.3: todo item listo es de un momento de la noche. El borrador puede no tenerlo todavia; el retirado no lo necesita.",
          "if": {
            "required": ["estado"],
            "properties": { "estado": { "const": "listo" } }
          },
          "then": { "required": ["momento"] }
        }
      ]
    },
    "opcion": {
      "comment": "Sin `correcta`: en un test de identidad no hay respuesta correcta (BR-17).",
      "type": "object",
      "additionalProperties": false,
      "required": ["texto", "polo"],
      "properties": {
        "texto": {
          "type": "string",
          "minLength": 2,
          "maxLength": 72,
          "not": { "pattern": "[Bb]ulacio|[Oo]lavarr|[Cc]roma[ñn]" }
        },
        "polo": { "enum": ["luz", "oscuridad", "orden", "caos"] }
      }
    }
  }
}
