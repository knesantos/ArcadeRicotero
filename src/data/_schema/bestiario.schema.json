{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ricotaarcade.local/schema/bestiario/1",
  "title": "D-73 — El bestiario redondo",
  "description": "Las regiones del mundo redondo y las bestias que viven en ellas. El verso de cada bestia es una cita de cancionero.json y se coteja a máquina (bestiario.test.ts). Lo que se cuenta aparte lleva el rótulo de D-14: hecho, leyenda o testimonio, y el testimonio dice quién lo contó.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pieza", "decision", "actualizado", "nota", "regiones", "bestias"],
  "properties": {
    "pieza": { "const": "bestiario" },
    "decision": { "const": "D-73" },
    "actualizado": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "nota": { "type": "string", "minLength": 1 },
    "regiones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "corto", "nombre", "canta", "disco", "forma", "vecinas"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "corto": { "type": "string", "minLength": 1, "maxLength": 14, "comment": "El rótulo del mapa entero: una o dos palabras." },
          "nombre": { "type": "string", "minLength": 1, "maxLength": 40 },
          "canta": { "type": "string", "minLength": 1, "maxLength": 60 },
          "disco": {
            "enum": [
              "gulp", "oktubre", "un-baion-para-el-ojo-idiota", "bang-bang-estas-liquidado", "la-mosca-y-la-sopa",
              "lobo-suelto", "cordero-atado", "luzbelito", "ultimo-bondi-a-finisterre", "momo-sampler", "marca", "ninguno"
            ]
          },
          "forma": {
            "oneOf": [
              {
                "type": "object", "additionalProperties": false, "required": ["tipo", "radio"],
                "properties": { "tipo": { "const": "centro" }, "radio": { "type": "number", "exclusiveMinimum": 0 } }
              },
              {
                "type": "object", "additionalProperties": false, "required": ["tipo", "desde", "hasta", "adentro", "afuera"],
                "properties": {
                  "tipo": { "const": "sector" },
                  "desde": { "type": "number" }, "hasta": { "type": "number" },
                  "adentro": { "type": "number", "minimum": 0 }, "afuera": { "type": "number", "maximum": 500 }
                }
              },
              {
                "type": "object", "additionalProperties": false, "required": ["tipo", "angulo", "distancia", "radio"],
                "properties": {
                  "tipo": { "const": "claro" }, "angulo": { "type": "number" },
                  "distancia": { "type": "number" }, "radio": { "type": "number", "exclusiveMinimum": 0 }
                }
              },
              {
                "type": "object", "additionalProperties": false, "required": ["tipo", "adentro", "afuera"],
                "properties": { "tipo": { "const": "anillo" }, "adentro": { "type": "number" }, "afuera": { "type": "number", "maximum": 500 } }
              }
            ]
          },
          "vecinas": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slug" } }
        }
      }
    },
    "bestias": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nombre", "clase", "region", "pos", "tam", "dibujo", "estampa", "cerca"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "nombre": { "type": "string", "minLength": 1, "maxLength": 50 },
          "clase": { "enum": ["bestia", "criatura", "personaje", "fierro"] },
          "region": { "$ref": "#/$defs/slug" },
          "pos": {
            "oneOf": [
              { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
              { "type": "object", "additionalProperties": false, "required": ["ang", "r"], "properties": { "ang": { "type": "number" }, "r": { "type": "number" } } }
            ]
          },
          "tam": { "type": "number", "minimum": 16, "maximum": 60 },
          "cantidad": { "type": "integer", "minimum": 2, "maximum": 4 },
          "dibujo": {
            "type": "object",
            "required": ["f"],
            "properties": { "f": { "enum": ["cuadrupedo", "ave", "bicho", "pez", "anguila", "rana", "almeja", "persona", "maquina", "cosa"] } }
          },
          "tema": { "$ref": "#/$defs/slug", "comment": "slug de cancionero.json" },
          "verso": { "$ref": "#/$defs/verso" },
          "tambien": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["tema", "verso"],
              "properties": { "tema": { "$ref": "#/$defs/slug" }, "verso": { "$ref": "#/$defs/verso" } }
            }
          },
          "articulo": { "$ref": "#/$defs/slug", "comment": "slug de redondopedia.json" },
          "estampa": { "type": "string", "minLength": 1, "maxLength": 320 },
          "cuenta": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rotulo", "texto"],
              "properties": {
                "rotulo": { "enum": ["hecho", "leyenda", "testimonio"] },
                "texto": { "type": "string", "minLength": 1 },
                "quien": { "type": "string", "minLength": 1 },
                "fuente": { "type": "string", "minLength": 1 }
              },
              "allOf": [
                { "if": { "properties": { "rotulo": { "const": "testimonio" } } }, "then": { "required": ["quien"] } },
                { "if": { "properties": { "rotulo": { "const": "hecho" } } }, "then": { "required": ["fuente"] } }
              ]
            }
          },
          "cerca": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slug" } }
        },
        "dependentRequired": { "tema": ["verso"], "verso": ["tema"] }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,90}$" },
    "verso": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 90 } }
  }
}
