{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ricotaarcade.local/schema/tapa/2",
  "title": "CTR-05 — Banco de adivinar la tapa",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contrato",
    "contratoVersion",
    "juego",
    "actualizado",
    "items"
  ],
  "properties": {
    "contrato": {
      "const": "CTR-05"
    },
    "contratoVersion": {
      "const": 2
    },
    "juego": {
      "const": "adivinar-tapa"
    },
    "actualizado": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "us",
        "dificultad",
        "imagen",
        "opciones",
        "fuentes",
        "sensibleA",
        "estado"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TP-\\d{3}$"
        },
        "us": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^US-\\d{2}$"
          }
        },
        "dificultad": {
          "enum": [
            "facil",
            "media",
            "dificil"
          ]
        },
        "imagen": {
          "$ref": "#/$defs/imagen"
        },
        "opciones": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/opcion"
          },
          "contains": {
            "type": "object",
            "required": [
              "correcta"
            ],
            "properties": {
              "correcta": {
                "const": true
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        "explicacion": {
          "type": "string",
          "minLength": 10,
          "maxLength": 400
        },
        "rotulo": {
          "$ref": "#/$defs/rotulo"
        },
        "fuentes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^RES-\\d{2}$"
          },
          "contains": {
            "const": "RES-44"
          },
          "minContains": 1
        },
        "sensibleA": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "letra",
              "tapa",
              "audio"
            ]
          },
          "contains": {
            "const": "tapa"
          },
          "minContains": 1
        },
        "estado": {
          "enum": [
            "borrador",
            "listo",
            "retirado"
          ]
        },
        "notaInterna": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "imagen"
            ],
            "properties": {
              "imagen": {
                "required": [
                  "auditoria"
                ],
                "properties": {
                  "auditoria": {
                    "const": "no determinable"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "estado": {
                "enum": [
                  "borrador",
                  "retirado"
                ]
              }
            }
          }
        },
        {
          "$comment": "US-04, 2026-08-28. Reemplaza a la regla anterior —«encuadre detalle implica dificultad media o dificil»— que codificaba un modelo que ya no existe: ahi «detalle» era la excepcion y la tapa entera el caso normal, asi que un recorte no podia ser lo mas facil. Hoy es al reves y por pedido del usuario: el juego funciona como los juegos de splash, ninguna tapa se muestra entera y lo que escalona es el LADO del zoom (facil 0.40 del master, media 0.26, dificil 0.22), no si hay recorte o no. La regla vieja bloqueaba justamente los tres faciles. El lado del zoom vive en scripts/generar-tapas.mjs; esta regla solo garantiza que nunca vuelva a jugarse una tapa entera, que es donde estaba la fuga: ocho de las diez tapas traen el titulo impreso.",
          "if": {
            "required": [
              "estado"
            ],
            "properties": {
              "estado": {
                "const": "listo"
              }
            }
          },
          "then": {
            "properties": {
              "imagen": {
                "properties": {
                  "encuadre": {
                    "const": "detalle"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "rotulo"
            ]
          },
          "then": {
            "required": [
              "explicacion"
            ]
          }
        },
        {
          "$comment": "CTR-05 v2, T-534. Un item que se juega trae la descripcion de su recorte: sin ella el juego no se puede jugar sin ver. Un borrador puede no tenerla todavia. Es lo que sube la version: un item listo de la v1 deja de validar.",
          "if": {
            "required": [
              "estado"
            ],
            "properties": {
              "estado": {
                "const": "listo"
              }
            }
          },
          "then": {
            "properties": {
              "imagen": {
                "required": [
                  "descripcion"
                ]
              }
            }
          }
        }
      ]
    },
    "imagen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archivo",
        "encuadre",
        "disco",
        "edicion",
        "auditoria",
        "credito"
      ],
      "properties": {
        "archivo": {
          "type": "string",
          "maxLength": 60,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "not": {
            "pattern": "-(detalle|fondo)$"
          }
        },
        "encuadre": {
          "enum": [
            "entera",
            "detalle"
          ]
        },
        "cara": {
          "enum": [
            "frontal",
            "trasera",
            "interior"
          ]
        },
        "disco": {
          "$ref": "#/$defs/tituloDeDisco"
        },
        "descripcion": {
          "$comment": "CTR-05 v2, T-534 (2026-11-20). Que se ve en el recorte, para quien no lo ve: es el alt de la imagen mientras se juega. Registro 3. No nombra el disco ni usa una palabra con peso del titulo de ninguna de las cuatro opciones del item; eso no se puede decir en JSON Schema y lo hace cumplir fugasDeDescripcion en src/lib/tapa/banco.ts, que corre en el build.",
          "type": "string",
          "minLength": 30,
          "maxLength": 240
        },
        "edicion": {
          "type": "string",
          "minLength": 10,
          "maxLength": 120
        },
        "auditoria": {
          "enum": [
            "original confirmada",
            "reedicion confirmada",
            "coincide con la original, sin marcador que lo pruebe",
            "no determinable"
          ]
        },
        "credito": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "autor",
            "origen"
          ],
          "properties": {
            "autor": {
              "enum": [
                "Rocambole (Ricardo Cohen)",
                "Rocambole, Semilla y Meroyuela"
              ]
            },
            "origen": {
              "enum": [
                "coveralia",
                "cover-art-archive"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "auditoria"
            ],
            "properties": {
              "auditoria": {
                "enum": [
                  "original confirmada",
                  "reedicion confirmada",
                  "coincide con la original, sin marcador que lo pruebe"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "edicion": {
                "pattern": "(19|20)\\d{2}"
              }
            }
          }
        }
      ]
    },
    "opcion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "texto",
        "correcta"
      ],
      "properties": {
        "texto": {
          "$ref": "#/$defs/tituloDeDisco"
        },
        "correcta": {
          "type": "boolean"
        },
        "nota": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "rotulo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo",
        "texto"
      ],
      "properties": {
        "tipo": {
          "enum": [
            "leyenda",
            "testimonio"
          ]
        },
        "texto": {
          "type": "string",
          "minLength": 20,
          "maxLength": 200
        }
      }
    },
    "tituloDeDisco": {
      "enum": [
        "Gulp!",
        "Oktubre",
        "Un baión para el ojo idiota",
        "¡Bang! ¡Bang!... Estás liquidado",
        "La mosca y la sopa",
        "Lobo suelto",
        "Cordero atado",
        "Luzbelito",
        "Último bondi a Finisterre",
        "Momo Sampler"
      ]
    }
  }
}
