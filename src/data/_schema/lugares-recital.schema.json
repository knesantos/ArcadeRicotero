{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ricotaarcade.local/schema/lugares-recital/1",
  "title": "D-72 — Los lugares para soñar de \"Armá tu recital\"",
  "description": "Estadios y teatros de la Argentina donde el jugador puede imaginar el recital. No afirma que la banda haya tocado ahí. El descampado y el lugar escrito a mano no viven acá: los arma el juego con lo que escribe el jugador.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pieza", "decision", "actualizado", "nota", "lugares"],
  "properties": {
    "pieza": { "const": "lugares-recital" },
    "decision": { "const": "D-72" },
    "actualizado": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "nota": { "type": "string", "minLength": 1 },
    "lugares": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "tipo", "nombre", "ciudad"],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,59}$",
            "not": { "enum": ["descampado", "otro"] },
            "comment": "Es lo que viaja en el link (desafio.ts). 'descampado' y 'otro' son del juego."
          },
          "tipo": { "enum": ["estadio", "teatro"] },
          "nombre": { "type": "string", "minLength": 1, "maxLength": 60 },
          "ciudad": { "type": "string", "minLength": 1, "maxLength": 40 }
        }
      }
    }
  }
}
