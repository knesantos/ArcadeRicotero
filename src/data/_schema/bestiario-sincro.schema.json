{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bestiario-sincro",
  "description": "D-78: en qué segundo del máster dice su verso cada bestia, y el recorte que arranca ahí. Lo escribe scripts/sincronizar-bestiario.mjs. De LRCLIB se guarda solo el tiempo, nunca la letra: por eso ningún campo admite texto de un tema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "actualizado", "nota", "recortes", "sinSincronizar"],
  "properties": {
    "decision": { "const": "D-78" },
    "actualizado": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "nota": { "type": "string", "minLength": 1 },
    "recortes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tema", "desdeSeg", "duracionMasterSeg"],
        "properties": {
          "id": { "$ref": "#/$defs/slug", "comment": "id de la bestia en bestiario.json" },
          "tema": { "$ref": "#/$defs/slug", "comment": "slug de cancionero.json" },
          "desdeSeg": { "type": "number", "minimum": 0 },
          "arranque": { "const": true, "comment": "D-73, decimosexta vuelta: el recorte va desde el segundo cero del tema, sin LRCLIB (DESDE_EL_ARRANQUE, lib/bestiario/sincro.ts)" },
          "coincidencia": { "type": "number", "minimum": 0, "maximum": 1 },
          "lrclib": { "type": "integer", "comment": "id de la versión de LRCLIB de donde salió el tiempo" },
          "duracionMasterSeg": { "type": "number", "exclusiveMinimum": 0 },
          "difDuracionSeg": { "type": "number" }
        },
        "if": { "not": { "required": ["arranque"] } },
        "then": { "required": ["coincidencia", "lrclib", "difDuracionSeg"] },
        "else": { "properties": { "desdeSeg": { "const": 0 } } }
      }
    },
    "sinSincronizar": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tema", "motivo"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "tema": { "$ref": "#/$defs/slug" },
          "motivo": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,90}$" }
  }
}
