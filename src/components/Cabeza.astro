---
/**
 * Lo que el sitio dice de si mismo cuando alguien lo saca a la calle.
 *
 * El bucle entero del quiz termina en `COMPARTÍ`, que manda un link a WhatsApp o a
 * Twitter. Hasta ahora ese link llegaba pelado: sin titulo, sin bajada, sin imagen, y la
 * pestaña del navegador mostraba el icono en blanco. Es el unico momento en que el sitio
 * sale afuera, y salia sin cara.
 *
 * Tres cosas que conviene no perder de vista:
 *
 * 1. **Las URL van absolutas.** Ningun previsualizador levanta un `og:image` relativo.
 *    Salen de `Astro.site`, que se declara en `astro.config.mjs` y en ningun otro lado.
 * 2. **El color de la barra sale del token, no de un hex copiado.** Lo lee
 *    `lib/sitio/tokens.ts` del propio `tokens.css`: si el fondo cambia, la barra cambia.
 * 3. **La tarjeta lleva su credito** (`D-21`, condicion 1). Adentro del sitio el credito
 *    de tapas vive en el pie de cada pantalla; una tarjeta compartida no tiene pie, asi
 *    que el credito viaja en `og:image:alt`, que es el unico lugar donde entra.
 */
import { token } from '../lib/sitio/tokens.ts';
import { PORTAL } from '../lib/sitio/copy.ts';

interface Props {
  /** El titulo de la tarjeta. Suele ser el mismo `<title>` de la pantalla. */
  titulo: string;
  /** La bajada de la tarjeta. Suele ser la misma `<meta name="description">`. */
  descripcion: string;
  /**
   * Una imagen de vista previa propia, de 1200 × 630, en vez de la del sitio. La usan "¿Qué
   * tipo de ricotero sos?" y sus cuatro postales (`D-57` punto 11): un resultado compartido
   * se ve con su nombre, no con la tarjeta genérica.
   */
  imagen?: string;
  /** Su texto alternativo, que es además donde viaja el crédito (`D-21`, condición 1). */
  imagenAlt?: string;
}

const { titulo, descripcion, imagen: propia, imagenAlt } = Astro.props;

const url = new URL(Astro.url.pathname, Astro.site).href;
const imagen = new URL(propia ?? '/tarjeta.png', Astro.site).href;
const alt = imagenAlt ?? PORTAL.altTarjeta;
---

<meta name="theme-color" content={token('--fondo')} />

{/*
  Las dos letras de marca se piden antes de que el CSS las descubra.

  El defecto que esto cierra es un P3 de la auditoria del 2026-08-24: una fuente
  declarada en `@font-face` no se baja hasta que el navegador **encuentra el elemento que
  la usa**, o sea despues de parsear `tokens.css` y armar el arbol. Con `font-display:
  swap` eso se ve: el titulo mas grande del sitio se dibuja en Arial Black y a los pocos
  cientos de milisegundos salta a la calcada. En una carga fria, en un celular, el salto
  es visible.

  No suma peso: los dos archivos se bajaban igual en cada pantalla —`--fuente-titular`
  escribe la marca y `--fuente-rotulada` cada titulo y cada boton—, solo que mas tarde.
  Suman 28,8 KB entre las dos desde `D-58`: hasta ahi la rotulada era un subconjunto de
  14 KB **sin la A-Z** —el de *latin-ext* de Google— y cada titulo caia a la letra de
  repuesto. `crossorigin` es obligatorio aunque sean del propio sitio: las fuentes viajan en
  modo anonimo, y sin el atributo el navegador baja el archivo dos veces.
*/}
<link rel="preload" href="/fuentes/oktubre-calco.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fuentes/archivo-black.woff2" as="font" type="font/woff2" crossorigin />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/icono-180.png" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={PORTAL.nombre} />
<meta property="og:locale" content="es_AR" />
<meta property="og:title" content={titulo} />
<meta property="og:description" content={descripcion} />
<meta property="og:url" content={url} />
<meta property="og:image" content={imagen} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={alt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={titulo} />
<meta name="twitter:description" content={descripcion} />
<meta name="twitter:image" content={imagen} />
<meta name="twitter:image:alt" content={alt} />

{/* La analítica de Vercel (`D-56`). Esta cabeza va en todas las pantallas, quiz incluido,
    así que se engancha una sola vez y acá. */}
<script>
  import '../scripts/analitica.ts';
</script>
