---
/**
 * La manera de quien mandó el enlace, en la portada de su postal (`D-57` punto 11).
 *
 * Es lo que el que llega no tenía: hasta el ciclo 18 leía "A alguien le salió «Luna llena»"
 * sin saber qué quería decir. Acá ve el nombre y los dos polos en palabras, pegado como una
 * etiqueta de papel. **Escrito en el HTML**: la vista previa ya lo prometió y no tiene que
 * esperar a ninguna isla.
 *
 * Sin la bajada, a propósito: con ella el botón quedaba abajo del pliegue a 375 × 667, y el
 * que llega por un enlace tiene que poder empezar sin buscar nada. La bajada entera la ve al
 * terminar, en la grilla de las cuatro maneras.
 */
import { POSTAL, lineaQueNombra, selloDePolos } from '../../lib/dos-ejes/copy.ts';
import type { Cuadrante } from '../../lib/dos-ejes/partida.ts';

interface Props {
  cuadrante: Cuadrante;
}
const { cuadrante: c } = Astro.props;
---

<aside class="ejes-amigo" aria-labelledby="ejes-amigo-nombre">
  <p class="ejes-rotulo">{POSTAL.rotulo}</p>
  <p class="ejes-amigo-nombre" id="ejes-amigo-nombre">{c.nombre}</p>
  <p class="ejes-polos">{selloDePolos(c.luzOscuridad, c.ordenCaos)}</p>
  <p class="ejes-nombra">{lineaQueNombra(c.luzOscuridad, c.ordenCaos)}</p>
</aside>
